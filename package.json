{
  "name": "newzwale",
  "type": "module",
  "version": "0.0.1",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=23.4.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "npm run build && wrangler dev",
    "astro": "astro",
    "deploy": "npm run build && wrangler deploy",
    "generate-types": "wrangler types",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 execute newzwale --local --file=src/lib/db/migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute newzwale --remote --file=src/lib/db/migrations/0001_init.sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.7",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.6",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
