---
import LogoIcon from './LogoIcon.astro';
import { CATEGORIES, RAIL_TOPICS } from '../lib/news/categories';

const currentPath = Astro.url.pathname;
const isNewsActive = currentPath === '/' || currentPath === '';
// /fact-check, not /verify: D8 (permanent 301, /verify no longer serves the page).
const isVerifyActive = currentPath.startsWith('/fact-check');

const activeCategory = currentPath.startsWith('/category/')
  ? currentPath.split('/')[2]
  : null;
---

<header id="site-header" class="sticky top-0 z-50 w-full bg-canvas/95 backdrop-blur-md border-b border-hairline transition-[transform,colors] duration-300 ease-out">
  <div class="max-w-[1400px] mx-auto h-[64px] px-3 sm:px-6 flex items-center justify-between">

    <!-- Brand Logo & Live Indicator -->
    <div class="flex items-center gap-2 sm:gap-3 shrink-0">
      <a href="/" class="flex items-center gap-2 group">
        <div class="relative flex items-center justify-center group-hover:scale-105 transition-transform">
          <LogoIcon className="w-7 h-7 sm:w-8 sm:h-8" />
          <span class="absolute -top-0.5 -right-0.5 w-2 h-2 sm:w-2.5 sm:h-2.5 bg-primary rounded-full animate-ping"></span>
          <span class="absolute -top-0.5 -right-0.5 w-2 h-2 sm:w-2.5 sm:h-2.5 bg-primary rounded-full"></span>
        </div>
        <div class="flex flex-col">
          <span class="font-semibold text-sm sm:text-base tracking-tight leading-tight text-ink">NewzWale</span>
          <span class="font-mono-caption text-[9px] sm:text-[10px] text-primary-strong font-semibold tracking-widest leading-none">Only Facts News</span>
        </div>
      </a>
    </div>

    <!-- Desktop Navigation Links -->
    <nav class="hidden lg:flex items-center gap-2" aria-label="Main Navigation">
      <a
        href="/"
        aria-current={isNewsActive ? "page" : undefined}
        class={`px-3 py-1.5 text-xs font-medium rounded-full transition-colors duration-200 ${
          isNewsActive
            ? 'bg-primary-strong text-on-primary shadow-stacked-sm font-semibold'
            : 'text-body hover:text-ink hover:bg-gradient-start'
        }`}
      >
        News
      </a>

      <a
        href="/fact-check"
        aria-current={isVerifyActive ? "page" : undefined}
        class={`px-3 py-1.5 text-xs font-medium rounded-full transition-colors duration-200 ${
          isVerifyActive
            ? 'bg-primary-strong text-on-primary shadow-stacked-sm font-semibold'
            : 'text-body hover:text-ink hover:bg-gradient-start'
        }`}
      >
        Fact Check
      </a>

      <!-- Customize Topics popover -->
      <div class="relative">
        <button
          type="button"
          id="topics-toggle"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="topics-panel"
          class="px-3 py-1.5 bg-secondary-bg hover:bg-secondary-pressed text-ink text-xs font-medium rounded-full transition-colors duration-200 cursor-pointer"
        >
          Customize topics
        </button>
        <div
          id="topics-panel"
          role="menu"
          aria-label="Homepage topics to show"
          hidden
          class="absolute right-0 top-[calc(100%+8px)] min-w-[200px] bg-surface-elevated border border-hairline rounded-md p-3.5 shadow-stacked-lg z-10"
        >
          <p class="text-xs font-semibold text-ink mb-2">Show sections for:</p>
          {RAIL_TOPICS.map((topic) => (
            <label class="flex items-center gap-2 py-1.5 text-sm text-body cursor-pointer">
              <input type="checkbox" data-topic-toggle={topic.label} class="accent-primary-strong" />
              {topic.label}
            </label>
          ))}
        </div>
      </div>

      <a
        href="/fact-check"
        class="px-4 py-1.5 bg-primary-strong hover:bg-primary-pressed text-on-primary text-xs font-semibold rounded-full shadow-stacked-sm transition-colors"
      >
        Verify a Claim
      </a>
    </nav>

    <!-- Mobile Hamburger Button -->
    <button
      id="mobile-menu-btn"
      type="button"
      aria-label="Toggle Navigation Menu"
      aria-expanded="false"
      aria-controls="mobile-menu-drawer"
      class="lg:hidden p-1.5 text-ink hover:bg-surface-card rounded-md transition-colors cursor-pointer"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
    </button>
  </div>

  <!-- Category strip: horizontally scrollable on narrow screens. The right-edge
       fade hints there's more to scroll to; it hides itself once you've
       scrolled to the end. -->
  <div class="relative w-full border-t border-hairline-soft bg-surface-soft">
    <nav
      id="category-strip"
      aria-label="News categories"
      class="max-w-[1400px] mx-auto px-3 sm:px-6 flex items-center gap-2 overflow-x-auto no-scrollbar h-[46px]"
    >
      {CATEGORIES.map((c) => (
        <a
          href={`/category/${c.slug}`}
          aria-current={activeCategory === c.slug ? 'page' : undefined}
          class={`shrink-0 px-3.5 py-1.5 text-xs font-medium rounded-full transition-colors duration-200 ${
            activeCategory === c.slug
              ? 'bg-primary-strong text-on-primary font-semibold shadow-stacked-sm'
              : 'bg-secondary-bg text-ink-soft hover:bg-secondary-pressed'
          }`}
        >
          {c.label}
        </a>
      ))}
    </nav>
    <div id="category-strip-fade" class="pointer-events-none absolute inset-y-0 right-0 w-10 bg-gradient-to-l from-surface-soft to-transparent transition-opacity duration-200" aria-hidden="true"></div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu-drawer" class="hidden lg:hidden border-b border-hairline bg-canvas px-4 py-4 space-y-2 shadow-stacked-lg text-xs font-semibold">
    <a href="/" class={`block px-3.5 py-2 rounded-md ${isNewsActive ? 'bg-primary-strong text-on-primary font-bold shadow-stacked-sm' : 'text-ink hover:bg-surface-card'}`}>
      News
    </a>
    <a href="/fact-check" class={`block px-3.5 py-2 rounded-md ${isVerifyActive ? 'bg-primary-strong text-on-primary font-bold shadow-stacked-sm' : 'text-primary-strong hover:bg-surface-card'}`}>
      Fact Check
    </a>

    <div class="pt-2 mt-2 border-t border-hairline-soft">
      <p class="px-3.5 pb-1 font-mono-caption text-mute">SHOW SECTIONS FOR</p>
      {RAIL_TOPICS.map((topic) => (
        <label class="flex items-center gap-2 px-3.5 py-2 text-ink cursor-pointer">
          <input type="checkbox" data-topic-toggle={topic.label} class="accent-primary-strong" />
          {topic.label}
        </label>
      ))}
    </div>

    <div class="pt-2 mt-2 border-t border-hairline-soft">
      <p class="px-3.5 pb-1 font-mono-caption text-mute">CATEGORIES</p>
      {CATEGORIES.map((c) => (
        <a
          href={`/category/${c.slug}`}
          aria-current={activeCategory === c.slug ? 'page' : undefined}
          class={`block px-3.5 py-2 rounded-md ${
            activeCategory === c.slug
              ? 'bg-primary-strong text-on-primary font-bold shadow-stacked-sm'
              : 'text-ink hover:bg-surface-card'
          }`}
        >
          {c.label}
        </a>
      ))}
    </div>
  </div>
</header>

<script>
  // Theme Toggle across all triggers
  document.querySelectorAll('.theme-toggle-trigger').forEach(btn => {
    btn.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });
  });

  // Mobile Drawer Toggle
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileDrawer = document.getElementById('mobile-menu-drawer');
  mobileBtn?.addEventListener('click', () => {
    const isOpen = mobileDrawer?.classList.toggle('hidden') === false;
    mobileBtn.setAttribute('aria-expanded', String(isOpen));
  });

  // Customize-topics popover
  const topicsToggle = document.getElementById('topics-toggle');
  const topicsPanel = document.getElementById('topics-panel');
  topicsToggle?.addEventListener('click', () => {
    const isHidden = topicsPanel?.toggleAttribute('hidden');
    topicsToggle.setAttribute('aria-expanded', String(isHidden === false));
  });
  document.addEventListener('click', (e) => {
    if (!topicsPanel || topicsPanel.hidden) return;
    const target = e.target as Node;
    if (topicsPanel.contains(target) || topicsToggle?.contains(target)) return;
    topicsPanel.hidden = true;
    topicsToggle?.setAttribute('aria-expanded', 'false');
  });

  // Language selector. Navigating (rather than refetching client-side) keeps
  // the choice in the URL, so it is shareable and survives a reload. The
  // localStorage copy is what the masthead date listens to.
  const langSelect = document.getElementById('language-select') as HTMLSelectElement | null;
  langSelect?.addEventListener('change', () => {
    const code = langSelect.value;
    const name = langSelect.options[langSelect.selectedIndex]?.text ?? code;

    localStorage.setItem('userLanguage', code);
    localStorage.setItem('userLanguageName', name);

    window.dispatchEvent(
      new CustomEvent('language-changed', { detail: { langCode: code, langName: name } }),
    );

    const url = new URL(window.location.href);
    if (code === 'en') url.searchParams.delete('language');
    else url.searchParams.set('language', code);
    window.location.assign(url.toString());
  });

  // Category strip edge fade: hide once scrolled to the end, or if it
  // doesn't overflow at all, so the hint never lies about there being more.
  const categoryStrip = document.getElementById('category-strip');
  const categoryFade = document.getElementById('category-strip-fade');
  if (categoryStrip && categoryFade) {
    const updateFade = () => {
      const atEnd = categoryStrip.scrollLeft + categoryStrip.clientWidth >= categoryStrip.scrollWidth - 1;
      categoryFade.style.opacity = atEnd ? '0' : '1';
    };
    updateFade();
    categoryStrip.addEventListener('scroll', updateFade, { passive: true });
    window.addEventListener('resize', updateFade);

    // One-time "peek" nudge: on first load, if there's more to see, scroll a
    // little and spring back. Motion is a far stronger scroll affordance
    // than a static fade, especially on touch screens.
    if (categoryStrip.scrollWidth > categoryStrip.clientWidth) {
      setTimeout(() => {
        categoryStrip.scrollTo({ left: 56, behavior: 'smooth' });
        setTimeout(() => categoryStrip.scrollTo({ left: 0, behavior: 'smooth' }), 450);
      }, 600);
    }
  }

  // Hide the header on scroll-down past the fold, reveal on scroll-up. Two
  // sticky rows (nav + category strip) cost ~107px of a phone viewport, so
  // giving that back while reading is worth more than permanent visibility.
  const header = document.getElementById('site-header');
  if (header) {
    let lastY = window.scrollY;
    let ticking = false;
    const REVEAL_THRESHOLD = 120; // px scrolled before hiding kicks in

    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          const y = window.scrollY;
          const scrollingDown = y > lastY;
          header.classList.toggle('-translate-y-full', scrollingDown && y > REVEAL_THRESHOLD);
          lastY = y;
          ticking = false;
        });
      },
      { passive: true },
    );
  }
</script>
