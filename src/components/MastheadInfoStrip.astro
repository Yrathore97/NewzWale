---
import { LANGUAGES, isValidLanguage, DEFAULT_LANGUAGE } from '../lib/news/languages';

/** Masthead utility strip: weather, date, market ticker, language, saved, theme.
 *
 *  P6 closed S-09 and A-07 here. This component used to make THREE third-party
 *  calls from the browser on every page load — open-meteo with precise
 *  coordinates, bigdatacloud with precise coordinates, and ipapi.co with the
 *  visitor's IP — and it called `navigator.geolocation.getCurrentPosition()`
 *  with no user gesture at all, so a permission prompt appeared unprompted on
 *  first visit.
 *
 *  All four are gone. Weather now comes from /api/v1/weather, which derives a
 *  city-level position from `request.cf` inside the Worker. The visitor's IP
 *  and exact position never leave our infrastructure, no permission is
 *  requested, and three origins left the CSP.
 */
const rawLanguage = Astro.url.searchParams.get('language');
const currentLanguage = isValidLanguage(rawLanguage) ? rawLanguage : DEFAULT_LANGUAGE;
---

<div
  id="masthead-info-strip"
  class="font-mono-caption relative w-full bg-surface-dark px-4 py-1.5 text-canvas transition-colors duration-200 dark:text-ink"
>
  <div
    id="masthead-strip-scroll"
    class="no-scrollbar mx-auto flex max-w-[1400px] items-center justify-between gap-4 overflow-x-auto"
  >
    <!-- Left: weather, date, ticker. This bar stays dark in both site themes,
         so every text colour here is the "always-dark-band" pair
         (light-mode token / dark:ink), never a token that inverts. -->
    <div class="flex shrink-0 items-center gap-4">
      <!-- Hidden until real data arrives. It previously shipped a hardcoded
           "New Delhi 31°C ☀️" in the markup, which is invented weather shown
           to every reader — the honest-states rule forbids exactly that. -->
      <div id="weather-widget-container" hidden class="flex items-center gap-1.5">
        <span id="weather-location" class="font-semibold text-canvas dark:text-ink"></span>
        <span class="opacity-70">·</span>
        <span id="weather-temp" class="font-semibold text-primary"></span>
        <span id="weather-condition"></span>
      </div>
      <span class="opacity-70" id="masthead-date-text"></span>
      <span id="ticker" hidden class="whitespace-nowrap opacity-80"></span>
    </div>

    <!-- Right: language, saved, theme -->
    <div class="flex shrink-0 items-center gap-4">
      <label class="flex items-center gap-1.5">
        <span class="hidden opacity-70 sm:inline">Language</span>
        <select
          id="language-select"
          aria-label="Choose the language of news headlines"
          title="Changes the language of news headlines, not the site interface"
          class="font-mono-caption cursor-pointer appearance-none rounded-md border border-charcoal bg-surface-dark px-1.5 py-0.5 text-canvas focus:outline-none focus:ring-1 focus:ring-primary-strong dark:border-hairline-soft dark:text-ink"
        >
          {
            LANGUAGES.map((lang) => (
              <option value={lang.code} selected={lang.code === currentLanguage}>
                {lang.name}
              </option>
            ))
          }
        </select>
      </label>

      <button
        type="button"
        id="saved-drawer-toggle"
        aria-label="View saved articles"
        aria-expanded="false"
        aria-controls="saved-drawer"
        class="font-mono-caption cursor-pointer border-none bg-transparent uppercase text-canvas hover:text-primary dark:text-ink"
      >
        Saved (<span data-saved-count>0</span>)
      </button>

      <button
        type="button"
        class="theme-toggle-trigger font-mono-caption cursor-pointer border-none bg-transparent uppercase text-canvas hover:text-primary dark:text-ink"
      >
        <span class="block dark:hidden">Light</span>
        <span class="hidden dark:block">Dark</span>
      </button>
    </div>
  </div>
  <div
    id="masthead-strip-fade"
    class="pointer-events-none absolute inset-y-0 right-0 w-10 bg-gradient-to-l from-surface-dark to-transparent transition-opacity duration-200"
    aria-hidden="true"
  >
  </div>
</div>

<script>
  const LANG_LOCALE_MAP: Record<string, string> = {
    en: 'en-IN',
    hi: 'hi-IN',
    bn: 'bn-IN',
    mr: 'mr-IN',
    te: 'te-IN',
    ta: 'ta-IN',
    gu: 'gu-IN',
    kn: 'kn-IN',
    ml: 'ml-IN',
    pa: 'pa-IN',
    or: 'or-IN',
    as: 'as-IN',
    ur: 'ur-IN',
  };

  function updateMastheadDate(langCode = 'en') {
    const el = document.getElementById('masthead-date-text');
    if (!el) return;
    const options: Intl.DateTimeFormatOptions = {
      weekday: 'short',
      month: 'short',
      day: 'numeric',
      year: 'numeric',
    };
    try {
      el.textContent = new Date().toLocaleDateString(LANG_LOCALE_MAP[langCode] ?? 'en-IN', options);
    } catch {
      el.textContent = new Date().toDateString();
    }
  }

  /** Presentation for the condition slugs /api/v1/weather returns. Anything
   *  not listed — including the API's own 'unknown' — renders no icon and no
   *  label rather than being forced into the nearest one. */
  const CONDITIONS: Record<string, { icon: string; text: string }> = {
    clear: { icon: '☀️', text: 'Clear' },
    'mainly-clear': { icon: '🌤️', text: 'Mainly clear' },
    'partly-cloudy': { icon: '⛅', text: 'Partly cloudy' },
    overcast: { icon: '☁️', text: 'Overcast' },
    fog: { icon: '🌫️', text: 'Fog' },
    drizzle: { icon: '🌧️', text: 'Drizzle' },
    rain: { icon: '🌧️', text: 'Rain' },
    'heavy-rain': { icon: '🌧️', text: 'Heavy rain' },
    'freezing-rain': { icon: '🌧️', text: 'Freezing rain' },
    snow: { icon: '❄️', text: 'Snow' },
    'heavy-snow': { icon: '❄️', text: 'Heavy snow' },
    showers: { icon: '🌦️', text: 'Showers' },
    'heavy-showers': { icon: '🌦️', text: 'Heavy showers' },
    thunderstorm: { icon: '🌩️', text: 'Thunderstorm' },
  };

  interface WeatherPayload {
    location: string | null;
    temperatureC: number;
    condition: string;
  }

  async function loadWeather() {
    const box = document.getElementById('weather-widget-container');
    const loc = document.getElementById('weather-location');
    const temp = document.getElementById('weather-temp');
    const cond = document.getElementById('weather-condition');
    if (!box || !loc || !temp || !cond) return;

    try {
      const res = await fetch('/api/v1/weather', { signal: AbortSignal.timeout(4000) });
      if (!res.ok) return; // stays hidden
      const body = (await res.json()) as { data?: WeatherPayload };
      const data = body.data;
      if (!data || typeof data.temperatureC !== 'number') return;

      // No city name means Cloudflare could not place the request. Showing the
      // temperature without a place is honest; substituting "New Delhi" is not.
      loc.textContent = data.location ?? 'Your area';
      temp.textContent = `${Math.round(data.temperatureC)}°C`;

      const c = CONDITIONS[data.condition];
      cond.textContent = c ? `${c.icon} ${c.text}` : '';

      box.hidden = false;
    } catch {
      // Network failure or timeout: the strip simply carries no weather.
      // Graceful degradation, with nothing invented to fill the gap.
    }
  }

  updateMastheadDate(localStorage.getItem('userLanguage') ?? 'en');
  loadWeather();

  window.addEventListener('language-changed', (e) => {
    const detail = (e as CustomEvent<{ langCode?: string }>).detail;
    updateMastheadDate(detail?.langCode ?? 'en');
  });

  // Edge fade hint: hidden once scrolled to the end, or if there is nothing to
  // scroll to begin with.
  const stripScroll = document.getElementById('masthead-strip-scroll');
  const stripFade = document.getElementById('masthead-strip-fade');
  if (stripScroll && stripFade) {
    const updateStripFade = () => {
      const atEnd =
        stripScroll.scrollLeft + stripScroll.clientWidth >= stripScroll.scrollWidth - 1;
      stripFade.style.opacity = atEnd ? '0' : '1';
    };
    updateStripFade();
    stripScroll.addEventListener('scroll', updateStripFade, { passive: true });
    window.addEventListener('resize', updateStripFade);

    // One-time peek nudge, skipped under reduced motion (UI/UX spec §9).
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (!reduced.matches && stripScroll.scrollWidth > stripScroll.clientWidth) {
      setTimeout(() => {
        stripScroll.scrollTo({ left: 56, behavior: 'smooth' });
        setTimeout(() => stripScroll.scrollTo({ left: 0, behavior: 'smooth' }), 450);
      }, 600);
    }
  }

  // Live market indices. The strip stays hidden unless real quotes arrive —
  // never show invented numbers.
  type Quote = { price: number; changePct: number | null };

  fetch('/api/ticker')
    .then((r) =>
      r.ok
        ? (r.json() as Promise<{ sensex: Quote; nifty: Quote }>)
        : Promise.reject(new Error('ticker unavailable')),
    )
    .then((d) => {
      const el = document.getElementById('ticker');
      if (!el) return;
      const fmt = (n: Quote, label: string) =>
        `${label} ${n.price.toFixed(2)}${
          n.changePct === null ? '' : ` (${n.changePct >= 0 ? '+' : ''}${n.changePct.toFixed(2)}%)`
        }`;
      el.textContent = `${fmt(d.sensex, 'SENSEX')} · ${fmt(d.nifty, 'NIFTY')}`;
      el.hidden = false;
    })
    .catch(() => {
      /* stays hidden - never show invented numbers */
    });

  document.getElementById('saved-drawer-toggle')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('nz-saved-drawer-toggle'));
  });
</script>
