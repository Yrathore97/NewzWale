---
import LogoIcon from './LogoIcon.astro';
---

<footer class="w-full bg-surface-dark py-8 sm:py-12 text-xs text-stone dark:text-mute transition-colors duration-200">
  <div class="max-w-[1400px] mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6 sm:gap-8 mb-8 sm:mb-10">

      <!-- Brand & Mission. This footer stays dark in both site themes, so
           every text colour is the "always-dark-band" pair (light-mode
           token / dark:<lighter fallback>), never a token that inverts. -->
      <div class="space-y-3 sm:col-span-2 md:col-span-1">
        <div class="flex items-center gap-2.5">
          <LogoIcon className="w-7 h-7" />
          <div class="flex flex-col">
            <span class="font-semibold text-sm text-canvas dark:text-ink leading-none">NewzWale</span>
            <span class="font-mono-caption text-[9px] text-primary font-semibold tracking-widest leading-none mt-0.5">Only Facts News</span>
          </div>
        </div>
        <p class="text-xs text-ash dark:text-mute leading-relaxed max-w-[320px]">
          Live Indian news headlines and a grounded fact-check tool that only issues a verdict when the evidence supports one.
        </p>
      </div>

      <!-- Column 1: Explore -->
      <div>
        <h4 class="font-mono-caption text-ash dark:text-mute mb-2.5 sm:mb-3 font-semibold">EXPLORE</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/" class="text-stone dark:text-mute hover:text-canvas dark:hover:text-ink transition-colors">News</a></li>
          <li><a href="/fact-check" class="text-stone dark:text-mute hover:text-canvas dark:hover:text-ink transition-colors">Fact Check</a></li>
        </ul>
      </div>

      <!-- Column 2: Fact Check -->
      <div>
        <h4 class="font-mono-caption text-ash dark:text-mute mb-2.5 sm:mb-3 font-semibold">FACT CHECK</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/fact-check" class="text-stone dark:text-mute hover:text-canvas dark:hover:text-ink transition-colors">Submit a Claim</a></li>
          <li><a href="/methodology" class="text-stone dark:text-mute hover:text-canvas dark:hover:text-ink transition-colors">Verification Methodology</a></li>
        </ul>
      </div>

      <!-- Column 3: Legal & Company -->
      <div>
        <h4 class="font-mono-caption text-ash dark:text-mute mb-2.5 sm:mb-3 font-semibold">LEGAL & COMPANY</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/privacy" class="text-stone dark:text-mute hover:text-canvas dark:hover:text-ink transition-colors">Privacy Policy</a></li>
          <li><a href="/terms" class="text-stone dark:text-mute hover:text-canvas dark:hover:text-ink transition-colors">Terms & Conditions</a></li>
          <li><a href="/about" class="text-stone dark:text-mute hover:text-canvas dark:hover:text-ink transition-colors">About Us</a></li>
          <li><a href="/contact" class="text-stone dark:text-mute hover:text-canvas dark:hover:text-ink transition-colors">Contact Us</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Compliance Strip -->
    <div class="pt-6 border-t border-charcoal dark:border-hairline-soft text-[11px] text-ash dark:text-mute">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-3 text-center sm:text-left">
        <div>
          © 2026 NewzWale. All rights reserved. Headlines, summaries, and source attributions only.
        </div>
        <div class="flex items-center gap-4">
          <span>Made with Astro & Tailwind CSS</span>
        </div>
      </div>
      <div class="flex flex-wrap items-center justify-center sm:justify-start gap-x-4 gap-y-1.5 mt-4">
        <a href="/privacy" class="hover:text-canvas dark:hover:text-ink transition-colors">Privacy Policy</a>
        <a href="/terms" class="hover:text-canvas dark:hover:text-ink transition-colors">Terms &amp; Conditions</a>
        <a href="/about" class="hover:text-canvas dark:hover:text-ink transition-colors">About Us</a>
        <a href="/contact" class="hover:text-canvas dark:hover:text-ink transition-colors">Contact Us</a>
      </div>
    </div>
  </div>
</footer>
