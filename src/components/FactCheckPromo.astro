---
const POINTS = [
  'A verdict of Verified, Misleading, or False is only returned when the retrieved evidence actually supports it.',
  'When the evidence is thin, the tool says so — "not enough evidence to judge" — instead of guessing.',
  'Every result links back to the sources it read, so you can check the reasoning yourself.',
];
---

<section class="w-full py-10">
  <div class="max-w-[1400px] mx-auto px-4 sm:px-6">
    <div class="bg-surface-card rounded-lg p-6 sm:p-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-10 items-center">
        <div>
          <span class="font-mono-caption text-primary-strong">VERIFICATION ENGINE</span>
          <h2 class="text-2xl sm:text-3xl font-bold text-ink tracking-[-0.5px] mt-3 mb-4">
            Fact Check Explorer
          </h2>
          <p class="text-sm sm:text-base text-body leading-relaxed mb-5">
            Paste a headline, a claim, or an article URL and it runs a three-stage pipeline: first it checks
            Google's Fact Check Tools database for an existing review; if nothing certified turns up, it runs
            a web search, fetches the matching pages, and asks a Workers AI model to weigh the claim against
            that evidence.
          </p>
          <a
            href="/fact-check"
            class="inline-block px-6 py-3 bg-primary-strong hover:bg-primary-pressed text-on-primary text-sm font-semibold rounded-md shadow-stacked-sm transition-colors"
          >
            Try Fact Check →
          </a>
        </div>
        <div class="flex flex-col gap-4">
          {POINTS.map((point) => (
            <div class="flex gap-3.5 items-start bg-surface-elevated rounded-md p-4">
              <span class="shrink-0 w-5.5 h-5.5 rounded-full bg-primary-strong text-on-primary text-xs flex items-center justify-center mt-0.5">✓</span>
              <p class="text-sm text-charcoal leading-relaxed m-0">{point}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
