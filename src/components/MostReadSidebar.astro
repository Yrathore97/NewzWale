---
import type { Article } from '../lib/news/types';
import { RAIL_TOPICS } from '../lib/news/categories';

interface Props {
  /** These are the most RECENT articles, not the most read. The prop name is
   *  kept for call-site compatibility; the label is not. */
  trending: Article[];
}

const { trending } = Astro.props;
---

<!-- This panel was headed "Most Read" and fed `top.slice(0, 5)` — the newest
     five headlines (audit §5, NEWZWALE_UI_UX_SPEC §2 "Redesign"). NewzWale has
     no read-count infrastructure, and inventing one to justify a heading would
     be the wrong way round. So the heading now says what the data actually is,
     and links to /trending, which IS ranked, and by a published method.
     Nothing here counts reads, and nothing here claims to. -->

<aside class="flex flex-col gap-6 self-start lg:sticky lg:top-[100px]">
  <div class="bg-surface-elevated border border-hairline rounded-md p-5 shadow-stacked-sm">
    <div class="mb-3.5 flex items-baseline justify-between gap-2">
      <h2 class="text-sm font-bold text-ink">Latest</h2>
      <a href="/trending" class="font-mono-caption text-primary-strong hover:underline">
        See trending
      </a>
    </div>
    <div class="flex flex-col gap-3.5">
      {trending.map((article, i) => (
        <a
          href={article.url}
          target="_blank"
          rel="noopener noreferrer"
          class="flex min-h-11 items-start gap-3 rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-strong"
        >
          {/* Position in a recency list, not a rank. aria-hidden so it is not
              read out as a ranking. */}
          <span class="shrink-0 font-mono text-lg font-bold text-stone" aria-hidden="true">{i + 1}</span>
          <span class="text-[13.5px] font-medium leading-snug text-ink">{article.title}</span>
        </a>
      ))}
    </div>

    <div class="border-t border-hairline mt-4.5 pt-4">
      <h3 class="text-xs font-semibold text-ink mb-2.5">Your topics</h3>
      <div class="flex flex-wrap gap-1.5">
        {RAIL_TOPICS.map((topic) => (
          <button
            type="button"
            data-topic-toggle={topic.label}
            aria-pressed="false"
            class="topic-chip min-h-11 cursor-pointer rounded-full border-none bg-secondary-bg px-3 text-xs text-ink-soft transition-colors"
          >
            {topic.label}
          </button>
        ))}
      </div>
    </div>
  </div>
</aside>

<style>
  .topic-chip.is-active {
    background-color: var(--color-primary-strong);
    color: var(--color-on-primary);
  }
</style>
