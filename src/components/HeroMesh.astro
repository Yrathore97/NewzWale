---
import type { Article } from '../lib/news/types';

/** Homepage hero.
 *
 *  TWO things were wrong here and both are fixed.
 *
 *  1. The search bar was fake. It filtered the article cards ALREADY IN THE DOM
 *     by substring — so "budget 2026" returned nothing whenever the budget
 *     story happened to be on page 2, and the reader had no way to tell the
 *     difference between "no such story" and "not loaded yet". It now posts to
 *     /search, which queries both corpora server-side.
 *
 *  2. It was 153 lines of hero before a single story appeared, carrying an
 *     eyebrow badge, a pinging dot, three feature pills and a large glow —
 *     every one of them on Part 13's forbidden list, and between them pushing
 *     real content below the fold. The hero is now ≤55vh on mobile.
 *
 *  The claim box is a WORKING fact-check entry point, not a link to one: what
 *  the reader types is carried into the check and lands on the confirmation
 *  step. It submits to the real /fact-check flow rather than re-implementing
 *  the pipeline here, so there is still exactly one fact-check implementation.
 */
const MAX_TICKER_ITEMS = 8;

let breakingNews: string[] = [];
try {
  const res = await fetch(new URL('/api/news?category=top', Astro.url));
  if (res.ok) {
    const articles = ((await res.json()) as { articles?: Article[] }).articles ?? [];
    // publishedAt can be '' (both the NewsData and RSS parsers default it), and
    // Date.parse('') is NaN - which makes the comparator return NaN and leaves
    // those items in engine-defined order. Coerce to 0 so they sort last.
    const time = (value: string): number => {
      const t = Date.parse(value || '');
      return Number.isNaN(t) ? 0 : t;
    };

    breakingNews = articles
      .filter((a) => a?.title)
      .sort((a, b) => time(b.publishedAt) - time(a.publishedAt))
      .slice(0, MAX_TICKER_ITEMS)
      .map((a) => a.title);
  }
} catch {
  /* stays hidden - never show invented headlines */
}
---

<section
  class="mesh-gradient-bg relative w-full border-b border-hairline transition-colors duration-200"
>
  <div class="relative z-10 mx-auto max-w-[1400px] px-4 py-8 sm:px-6 sm:py-12">
    <div class="mx-auto flex max-w-3xl flex-col gap-5">
      <div>
        <h1
          class="text-[28px] font-semibold leading-[1.15] tracking-[-0.8px] text-ink sm:text-4xl sm:tracking-[-1.4px]"
        >
          Know what's true.<br />Not just what's trending.
        </h1>
        <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-body sm:text-base">
          Live Indian news, plus a fact-checker that shows its evidence.
        </p>
      </div>

      <!-- The working fact-check input. -->
      <form
        id="hero-claim-form"
        action="/fact-check"
        method="get"
        class="flex w-full flex-col gap-2"
      >
        <label for="hero-claim" class="sr-only">
          Paste a claim, headline or link to fact-check
        </label>
        <textarea
          id="hero-claim"
          name="claim"
          rows="2"
          required
          maxlength="2000"
          autocomplete="off"
          placeholder="Paste a claim, headline, or link…"
          class="w-full resize-y rounded-sm border border-hairline bg-surface-elevated px-4 py-3 text-base leading-relaxed text-ink placeholder:text-mute focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-strong"
        ></textarea>

        <div class="flex flex-wrap items-center gap-2">
          <button
            type="submit"
            class="btn-pill-primary inline-flex min-h-11 cursor-pointer items-center px-5 text-sm"
          >
            Fact-check this
          </button>

          <!-- Hidden until scripting confirms the Clipboard API exists, so we
               never offer an affordance that cannot work. -->
          <button
            type="button"
            id="hero-paste"
            hidden
            class="btn-pill-secondary inline-flex min-h-11 cursor-pointer items-center px-5 text-sm"
          >
            Paste from clipboard
          </button>

          <a
            href="#news-feed"
            class="inline-flex min-h-11 items-center px-2 text-sm font-semibold text-primary-strong"
          >
            Read the news ↓
          </a>
        </div>

        <p class="font-mono-caption text-mute">
          Checks published fact-checkers, then live sources.
        </p>
        <p id="hero-claim-status" role="status" aria-live="polite" class="text-xs text-mute"></p>
      </form>
    </div>
  </div>

  <!-- Ticker (only renders with real headlines from /api/news) -->
  {
    breakingNews.length > 0 && (
      <div class="w-full overflow-hidden border-y border-charcoal bg-surface-dark py-2 text-canvas dark:border-hairline-soft dark:text-ink">
        <div class="mx-auto flex max-w-[1400px] items-center gap-3 px-3 sm:px-4">
          <span class="font-mono-caption shrink-0 rounded-full bg-charcoal px-2 py-0.5 text-primary dark:bg-hairline-soft">
            Breaking
          </span>
          <div class="relative w-full overflow-hidden">
            <div class="animate-marquee flex items-center gap-8 whitespace-nowrap text-xs">
              {breakingNews.map((news) => (
                <span>{news}</span>
              ))}
              {/* Duplicated purely so the marquee loops seamlessly; hidden from
                  assistive tech so headlines are not announced twice. */}
              {breakingNews.map((news) => (
                <span aria-hidden="true">{news}</span>
              ))}
            </div>
          </div>
        </div>
      </div>
    )
  }
</section>

<script>
  const form = document.getElementById('hero-claim-form') as HTMLFormElement | null;
  const input = document.getElementById('hero-claim') as HTMLTextAreaElement | null;
  const paste = document.getElementById('hero-paste') as HTMLButtonElement | null;
  const status = document.getElementById('hero-claim-status');

  // "Paste from clipboard" is the single most valuable affordance for the
  // primary use case — someone arriving from WhatsApp with a forwarded claim
  // (NEWZWALE_UI_UX_SPEC §5.1). Feature-detected, because readText() does not
  // exist in every browser and is permission-gated in the ones that have it.
  if (paste && input && navigator.clipboard && 'readText' in navigator.clipboard) {
    paste.hidden = false;
    paste.addEventListener('click', async () => {
      try {
        const text = await navigator.clipboard.readText();
        if (!text.trim()) {
          if (status) status.textContent = 'Your clipboard is empty.';
          return;
        }
        input.value = text.trim().slice(0, 2000);
        input.focus();
        if (status) status.textContent = 'Pasted from clipboard.';
      } catch {
        // Permission refused, or a browser that gates readText behind a user
        // setting. Say so rather than failing silently.
        if (status) {
          status.textContent = 'Clipboard access was blocked. Paste with Ctrl+V instead.';
        }
      }
    });
  }

  // A plain GET form already works without this handler; it exists only to
  // trim and to stop an all-whitespace submission.
  form?.addEventListener('submit', (event) => {
    if (!input) return;
    const value = input.value.trim();
    if (!value) {
      event.preventDefault();
      if (status) status.textContent = 'Enter a claim, headline or link to check.';
      input.focus();
      return;
    }
    input.value = value;
  });
</script>
