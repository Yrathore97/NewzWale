---
import type { Article, NewsPage } from '../lib/news/types';
import { prepareArticles } from '../lib/news/feed';
import { DEFAULT_CATEGORY } from '../lib/news/categories';
import { DEFAULT_LANGUAGE, LANGUAGES } from '../lib/news/languages';
import ArticleCard from './ArticleCard.astro';
import ArticleGrid from './news/ArticleGrid.astro';
import EmptyState from './shared/EmptyState.astro';
import ErrorState from './shared/ErrorState.astro';

/** The headline grid, plus the "Load more" path.
 *
 *  The client-side `buildCard()` that used to live at the bottom of this file
 *  is GONE. It was a 95-line hand-rolled duplicate of ArticleCard.astro, and it
 *  had already drifted: different image height, different summary size, no
 *  save button on imageless cards. Along with it went local copies of
 *  `formatPublished` and `isSafeUrl`, which existed in `lib/` the whole time.
 *
 *  Appended cards are now clones of a <template> rendered by ArticleCard
 *  itself, so the server path and the client path cannot diverge again.
 */
interface Props {
  category?: string;
  language?: string;
  heading?: string;
  /** Articles already rendered elsewhere on the page (lead, rails), so the
   *  grid does not repeat them. */
  excludeUrls?: string[];
}

const {
  category = DEFAULT_CATEGORY,
  language = DEFAULT_LANGUAGE,
  heading = 'Major Headlines',
  excludeUrls = [],
} = Astro.props;

const MAX_CARDS = 24;

let articles: Article[] = [];
let nextPage: string | null = null;
/** Distinguishes "the feed is empty" from "the request failed". The two need
 *  different copy: one is a state of the world, the other is our fault. */
let failed = false;

try {
  const res = await fetch(
    new URL(
      `/api/news?category=${encodeURIComponent(category)}&language=${encodeURIComponent(language)}`,
      Astro.url,
    ),
  );
  if (res.ok) {
    const page = (await res.json()) as NewsPage;
    articles = page.articles ?? [];
    nextPage = page.nextPage ?? null;
  } else {
    failed = true;
  }
} catch {
  failed = true;
}

const exclude = new Set(excludeUrls);
articles = prepareArticles(articles, MAX_CARDS).filter((a) => !exclude.has(a.url));

// The language selector only ever changes what's fetched here, never the
// site's own UI text - this note is the one place that says so out loud,
// rather than leaving a first-time switcher to infer it from a hover title.
const languageName = LANGUAGES.find((l) => l.code === language)?.name ?? language;
const categoryLabel = category === DEFAULT_CATEGORY ? 'this feed' : category;
---

<section id="news-feed" class="w-full bg-surface-soft py-10 transition-colors duration-200">
  <div class="mx-auto max-w-[1400px] px-4 sm:px-6">
    <div
      class="mb-6 flex flex-col justify-between gap-3 border-b border-hairline pb-4 md:flex-row md:items-center"
    >
      <div>
        <span id="feed-type-badge" class="font-mono-caption text-mute">Live headline stream</span>
        <h2 class="text-2xl font-semibold tracking-[-0.96px] text-ink sm:text-3xl">{heading}</h2>
        {
          language !== DEFAULT_LANGUAGE && (
            <p class="mt-1 text-xs text-mute">
              Showing headlines in {languageName} — site menus and buttons stay in English.
            </p>
          )
        }
      </div>
    </div>

    {
      failed ? (
        <ErrorState
          title="Couldn't load headlines"
          description="The headline feed did not respond. Your connection is fine if the rest of this page loaded."
          retryLabel="Reload headlines"
          retryHref={Astro.url.pathname + Astro.url.search}
        />
      ) : articles.length === 0 ? (
        <EmptyState
          title={`No headlines in ${categoryLabel} right now`}
          description="Publisher feeds for this selection returned nothing in the current window. Other categories are still updating."
          actionLabel="Browse all categories"
          actionHref="/news"
        />
      ) : (
        <>
          <ArticleGrid id="articles-grid">
            {articles.map((article) => (
              <ArticleCard article={article} />
            ))}
          </ArticleGrid>

          {/* The one card template, rendered by ArticleCard itself. */}
          <ArticleCard asTemplate templateId="article-card-template" />

          <div class="mt-8 flex flex-col items-center gap-3">
            <button
              id="load-more"
              type="button"
              hidden={!nextPage}
              data-next-page={nextPage ?? ''}
              data-category={category}
              data-language={language}
              class="min-h-11 rounded-sm bg-ink px-6 text-sm font-semibold text-canvas shadow-stacked-sm transition-colors hover:bg-charcoal disabled:cursor-not-allowed disabled:opacity-60"
            >
              Load more headlines
            </button>
            <p id="load-more-status" role="status" aria-live="polite" class="text-xs text-mute" />
          </div>
        </>
      )
    }
  </div>
</section>

<script>
  // Imported from lib/, not re-implemented. Both of these previously existed
  // as private copies in this file that had already drifted from the originals.
  import { formatPublished } from '../lib/news/feed';
  import { isSafeUrl, safeHref } from '../lib/url';

  const btn = document.getElementById('load-more') as HTMLButtonElement | null;
  const grid = document.getElementById('articles-grid');
  const status = document.getElementById('load-more-status');
  const template = document.getElementById('article-card-template') as HTMLTemplateElement | null;

  interface FeedArticle {
    id: string;
    title: string;
    url: string;
    summary: string;
    imageUrl: string | null;
    source: string;
    category: string;
    publishedAt: string;
  }

  /** Fills one clone of ArticleCard's own markup.
   *
   *  textContent for every string, and safeHref() for every URL. No innerHTML
   *  anywhere: a headline is third-party text and an image URL is
   *  provider-supplied, so both are treated as hostile.
   */
  function buildCard(a: FeedArticle): DocumentFragment | null {
    if (!template) return null;
    const frag = template.content.cloneNode(true) as DocumentFragment;

    const root = frag.querySelector<HTMLElement>('[data-article-card]');
    if (!root) return null;
    root.dataset.articleId = a.id;

    const setField = (name: string, value: string) => {
      for (const el of frag.querySelectorAll<HTMLElement>(`[data-field="${name}"]`)) {
        el.textContent = value;
      }
    };

    setField('title', a.title);
    setField('title-sr', a.title);
    setField('source', a.source);
    setField('category', a.category);
    setField('published', formatPublished(a.publishedAt));
    setField('summary', a.summary ?? '');

    const summaryBox = frag.querySelector<HTMLElement>('[data-card-summary]');
    if (summaryBox) summaryBox.hidden = !a.summary;

    const media = frag.querySelector<HTMLElement>('[data-card-media]');
    const image = frag.querySelector<HTMLImageElement>('[data-card-image]');
    const imageSrc = a.imageUrl ? safeHref(a.imageUrl) : null;
    if (media) media.hidden = imageSrc === null;
    if (image && imageSrc) image.src = imageSrc;

    const href = safeHref(a.url);
    for (const link of frag.querySelectorAll<HTMLAnchorElement>('a[data-card-link]')) {
      // The template ships without an href; only a validated one is ever set.
      if (href) {
        link.href = href;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
      } else {
        link.removeAttribute('href');
      }
    }

    const saved = window.NZ?.isSaved(a.url) ?? false;
    for (const save of frag.querySelectorAll<HTMLElement>('[data-card-save]')) {
      save.setAttribute('data-save-href', a.url);
      save.setAttribute('data-save-headline', a.title);
      save.setAttribute('aria-pressed', String(saved));
      save.classList.toggle('is-saved', saved);
      const label = save.querySelector<HTMLElement>('[data-save-label]');
      if (label) label.textContent = saved ? 'Saved' : 'Save';
    }

    return frag;
  }

  btn?.addEventListener('click', async () => {
    const token = btn.dataset.nextPage;
    if (!token || !grid) return;

    btn.disabled = true;
    const label = btn.textContent;
    btn.textContent = 'Loading…';
    if (status) status.textContent = '';

    const params = new URLSearchParams({
      category: btn.dataset.category ?? 'top',
      language: btn.dataset.language ?? 'en',
      page: token,
    });

    try {
      const res = await fetch(`/api/news?${params}`);
      if (!res.ok) throw new Error(`status ${res.status}`);
      const page = (await res.json()) as { articles?: FeedArticle[]; nextPage?: string | null };

      const seen = new Set(
        Array.from(grid.querySelectorAll<HTMLElement>('[data-article-id]')).map(
          (n) => n.dataset.articleId ?? '',
        ),
      );

      const fresh = (page.articles ?? []).filter(
        (a) => a?.url && a?.title && isSafeUrl(a.url) && !seen.has(a.id),
      );

      // Appended, so keyboard focus order stays natural.
      for (const a of fresh) {
        const card = buildCard(a);
        if (card) grid.appendChild(card);
      }

      if (page.nextPage) {
        btn.dataset.nextPage = page.nextPage;
        btn.disabled = false;
        btn.textContent = label;
        if (status && fresh.length === 0) status.textContent = 'No new headlines in that batch.';
      } else {
        btn.remove();
        if (status) status.textContent = "You've reached the end of the feed.";
      }
    } catch {
      btn.disabled = false;
      btn.textContent = label;
      // Existing cards stay on screen - a failed page never clears the feed.
      if (status) status.textContent = 'Could not load more headlines. Tap to try again.';
    }
  });
</script>
