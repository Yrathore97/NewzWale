---
import ClaimInput from './factcheck/ClaimInput.astro';
import ClaimConfirm from './factcheck/ClaimConfirm.astro';
import CheckProgress from './factcheck/CheckProgress.astro';
import VerdictBadge from './factcheck/VerdictBadge.astro';
import EvidenceStrengthMeter from './factcheck/EvidenceStrengthMeter.astro';
import ErrorState from './shared/ErrorState.astro';

/** EvidenceList, LimitationsPanel and ShareResult are NOT imported as
 *  components here. Their markup is instead built client-side in the script
 *  below, because /api/factcheck's result is one JSON payload rather than a
 *  server-rendered page — there is nowhere for Astro to render those three
 *  into. The client renderers below are kept structurally identical to the
 *  .astro components of the same name; those components are what
 *  /fact-check/[id].astro (the persisted result page) actually uses. */

/** The fact-check flow: claim → confirm → progress → result.
 *
 *  Replaces the previous three-tab widget (Text / URL / Image) with the
 *  single-input flow from NEWZWALE_UI_UX_SPEC §5. Steps are plain sections
 *  toggled by `hidden`, not an ARIA tabs pattern — they are sequential stages
 *  of one task, not independently selectable views, so `tablist`/`tab` would
 *  have been the wrong semantics (that mismatch is exactly what the previous
 *  widget's incomplete tablist got wrong per audit A-02).
 *
 *  PIPELINE UNCHANGED. This posts to the same /api/factcheck the previous
 *  widget used — same validation, rate limiting, evidence retrieval, six
 *  verdicts, persistence. Nothing here re-implements or alters any of that;
 *  it only presents the result.
 *
 *  SECURITY UNCHANGED: every evidence field is written with
 *  createElement/textContent, and every href goes through the same
 *  safe-scheme check used elsewhere in the codebase. No innerHTML.
 */
---

<section
  id="fact-checker"
  class="w-full border-b border-hairline bg-canvas py-8 transition-colors duration-200 sm:py-12"
>
  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <div class="rounded-md border border-hairline bg-surface-soft p-4 shadow-stacked-md sm:p-6">
      <ClaimInput />
      <ClaimConfirm />
      <CheckProgress />

      {/* MUST be a <div>, not a <p>. ErrorState's root is a block-level
          <div>, and the HTML parser auto-closes an open <p> before a block
          child - so as a <p> this wrapper was left EMPTY and the error markup
          was hoisted out as a sibling. `hidden` then toggled an empty
          element while the real banner stayed permanently visible: every
          visitor to /fact-check saw "Couldn't check that claim" at all times,
          including alongside a successful verdict. Found in production. */}
      <div id="factcheck-error-wrap" hidden>
        <ErrorState
          title="Couldn't check that claim"
          description="The verification service did not return a result. Your claim has not been lost — try again."
          retryTarget="factcheck"
        />
      </div>

      <!-- Result. aria-live so a screen-reader user hears the verdict land
           without having to go looking for it (UI/UX spec §7 "new"). -->
      <div id="factcheck-result" hidden aria-live="polite" class="mt-6 flex flex-col gap-6 border-t border-hairline pt-6">
        <div
          class="flex flex-col items-start justify-between gap-3 rounded-sm border border-hairline bg-surface-elevated p-4 sm:flex-row sm:items-center"
        >
          <!-- Side by side, equal weight: a TRUE on weak evidence must not
               look like a TRUE on strong evidence (UI/UX spec §5.4). -->
          <div id="result-verdict-slot"></div>
          <div id="result-strength-slot"></div>
        </div>

        <p id="result-basis-note" class="text-sm text-mute"></p>

        <div>
          <h3 class="font-mono-caption mb-1 text-mute">Summary</h3>
          <p
            id="result-summary"
            class="rounded-sm border border-hairline bg-surface-elevated p-4 text-sm font-medium leading-relaxed text-ink shadow-stacked-sm"
          ></p>
        </div>

        <div id="result-evidence-slot"></div>
        <div id="result-limitations-slot"></div>
        <div id="result-share-slot"></div>
      </div>
    </div>
  </div>
</section>

<!-- Fillable templates, cloned by the script below. Keeps the result markup
     identical to what the standalone result page renders, per component. -->
<VerdictBadge asTemplate templateId="tpl-verdict-badge" size="large" />
<EvidenceStrengthMeter asTemplate templateId="tpl-strength-meter" />

<script>
  import { safeHref } from '../lib/url';
  import { recordFactCheckHistory } from '../lib/history/factcheck-history';

  type Verdict =
    | 'true'
    | 'false'
    | 'partly_true'
    | 'misleading'
    | 'unverified'
    | 'needs_context';

  interface Evidence {
    title: string;
    url: string;
    publisher: string;
    tier?: 'tier1' | 'tier2' | 'tier3';
    stance?: 'supports' | 'contradicts' | 'neutral' | 'unclear';
    publishedAt?: string | null;
    accessedAt?: string;
    quotedPassage?: string;
    readMethod?: 'full_page' | 'search_snippet';
    injectionFlagged?: boolean;
    relevant?: boolean;
    position?: number;
  }

  interface FactCheckResult {
    verdict?: Verdict;
    explanation?: string;
    basis?: 'certified' | 'ai_assessment' | 'none';
    evidence?: Evidence[];
    id?: string;
    claim?: string;
    evidenceStrength?: 'strong' | 'moderate' | 'weak' | 'none';
    summary?: string;
    limitations?: string[];
  }

  // ── Elements ──────────────────────────────────────────────────────────
  const inputStep = document.getElementById('claim-input-step');
  const confirmStep = document.getElementById('claim-confirm-step');
  const progress = document.getElementById('check-progress');
  const progressLive = document.getElementById('check-progress-live');
  const errorWrap = document.getElementById('factcheck-error-wrap');
  const resultBox = document.getElementById('factcheck-result');

  const claimInput = document.getElementById('claim-input') as HTMLTextAreaElement | null;
  const claimTypeNote = document.getElementById('claim-type-note');
  const submitBtn = document.getElementById('claim-submit');
  const pasteBtn = document.getElementById('claim-paste') as HTMLButtonElement | null;

  const confirmText = document.getElementById('claim-confirm-text');
  const confirmOrigin = document.getElementById('claim-confirm-origin');
  const confirmOriginHost = document.getElementById('claim-confirm-origin-host');
  const confirmEdit = document.getElementById('claim-confirm-edit') as HTMLTextAreaElement | null;
  const confirmGo = document.getElementById('claim-confirm-go');
  const confirmEditBtn = document.getElementById('claim-confirm-edit-btn');
  const confirmBack = document.getElementById('claim-confirm-back');

  // ── Detect: URL vs text. Never asks the reader to classify their input. ──
  function detect(raw: string): { source: 'url' | 'text'; value: string } {
    const trimmed = raw.trim();
    try {
      const url = new URL(trimmed);
      if (url.protocol === 'http:' || url.protocol === 'https:') {
        return { source: 'url', value: trimmed };
      }
    } catch {
      /* not a URL */
    }
    return { source: 'text', value: trimmed };
  }

  // A short typed claim is already its own confirmation; only a URL or a long
  // paragraph gets the confirmation step (UI/UX spec §5.2).
  const CONFIRM_MIN_CHARS = 140;

  let pendingSource: 'url' | 'text' = 'text';

  function showStep(step: 'input' | 'confirm' | 'progress' | 'result' | 'error') {
    if (inputStep) inputStep.hidden = step !== 'input';
    if (confirmStep) confirmStep.hidden = step !== 'confirm';
    if (progress) progress.hidden = step !== 'progress';
    if (errorWrap) errorWrap.hidden = step !== 'error';
    if (resultBox) resultBox.hidden = step !== 'result';
  }

  // ── Demo prompts ──
  for (const btn of document.querySelectorAll<HTMLButtonElement>('.demo-prompt-btn')) {
    btn.addEventListener('click', () => {
      if (claimInput) {
        claimInput.value = btn.dataset.demoClaim ?? '';
        claimInput.focus();
      }
    });
  }

  // ── Paste from clipboard ──
  if (pasteBtn && claimInput && navigator.clipboard && 'readText' in navigator.clipboard) {
    pasteBtn.hidden = false;
    pasteBtn.addEventListener('click', async () => {
      try {
        const text = await navigator.clipboard.readText();
        if (text.trim()) {
          claimInput.value = text.trim().slice(0, 2000);
          claimInput.focus();
        }
      } catch {
        if (claimTypeNote) claimTypeNote.textContent = 'Clipboard access was blocked. Paste with Ctrl+V instead.';
      }
    });
  }

  // Live "URL detected" note as the reader types, so the interpretation is
  // visible before they even submit.
  claimInput?.addEventListener('input', () => {
    if (!claimTypeNote) return;
    const { source } = detect(claimInput.value);
    claimTypeNote.textContent =
      claimInput.value.trim() && source === 'url' ? 'Link detected — we will read the article.' : '';
  });

  function goToConfirmOrCheck() {
    if (!claimInput) return;
    const { source, value } = detect(claimInput.value);
    if (!value) {
      if (claimTypeNote) claimTypeNote.textContent = 'Enter a claim, headline or link to check.';
      claimInput.focus();
      return;
    }

    pendingSource = source;

    if (source === 'url' || value.length >= CONFIRM_MIN_CHARS) {
      if (confirmText) confirmText.textContent = value;
      if (confirmEdit) confirmEdit.value = value;
      if (confirmOrigin && confirmOriginHost) {
        if (source === 'url') {
          confirmOrigin.hidden = false;
          try {
            confirmOriginHost.textContent = new URL(value).hostname;
          } catch {
            confirmOriginHost.textContent = value;
          }
        } else {
          confirmOrigin.hidden = true;
        }
      }
      confirmEdit?.setAttribute('hidden', '');
      confirmText?.parentElement?.removeAttribute('hidden');
      showStep('confirm');
      (document.getElementById('claim-confirm-go') as HTMLElement | null)?.focus();
    } else {
      runCheck(value, source);
    }
  }

  submitBtn?.addEventListener('click', goToConfirmOrCheck);

  confirmBack?.addEventListener('click', () => showStep('input'));

  confirmEditBtn?.addEventListener('click', () => {
    if (!confirmEdit || !confirmText) return;
    const editing = confirmEdit.hidden;
    confirmEdit.hidden = !editing;
    confirmText.parentElement?.toggleAttribute('hidden', Boolean(editing));
    if (editing) confirmEdit.focus();
  });

  confirmGo?.addEventListener('click', () => {
    const finalText =
      confirmEdit && !confirmEdit.hidden ? confirmEdit.value.trim() : (confirmText?.textContent ?? '').trim();
    if (!finalText) return;
    // Editing free-text always resubmits as a claim, even if the original
    // input was a URL — the reader has now told us the claim in words.
    const source = confirmEdit && !confirmEdit.hidden ? 'text' : pendingSource;
    runCheck(finalText, source as 'url' | 'text');
  });

  // ── Staged progress. See CheckProgress.astro for why this is not a fake
  //    animated percentage: the API is one request/response, so stages are
  //    resolved from the RESULT, not ticked against a timer. ──
  function setStage(id: string, state: 'pending' | 'running' | 'done' | 'skipped', detail?: string) {
    const li = progress?.querySelector<HTMLElement>(`[data-stage="${id}"]`);
    if (!li) return;
    li.dataset.state = state;
    const icon = li.querySelector('[data-stage-icon]');
    if (icon) icon.textContent = state === 'done' ? '✓' : state === 'running' ? '◐' : state === 'skipped' ? '–' : '○';
    const detailEl = li.querySelector('[data-stage-detail]');
    if (detailEl) detailEl.textContent = detail ?? '';
  }

  function announce(text: string) {
    if (progressLive) progressLive.textContent = text;
  }

  async function runCheck(value: string, source: 'url' | 'text') {
    showStep('progress');
    for (const id of ['certified', 'search', 'read', 'weigh', 'verdict']) setStage(id, 'pending');
    setStage('certified', 'running');
    announce('Checking published fact-checkers.');

    const body = source === 'url' ? { url: value } : { claim: value };

    try {
      const res = await fetch('/api/factcheck', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      const data = (await res.json()) as FactCheckResult & { error?: string };

      if (!res.ok) {
        showStep('error');
        const desc = document.querySelector('#factcheck-error-wrap [data-nz-retry], #factcheck-error-wrap p');
        if (desc) desc.textContent = data.error || 'Could not check that claim.';
        return;
      }

      // Every stage the API result implies actually ran resolves to done;
      // nothing is ticked that the response gives no evidence for.
      setStage('certified', data.basis === 'certified' ? 'done' : 'skipped', data.basis === 'certified' ? 'Match found' : undefined);
      const evidenceCount = data.evidence?.length ?? 0;
      setStage('search', evidenceCount > 0 ? 'done' : 'skipped', evidenceCount > 0 ? `${evidenceCount} found` : 'No sources found');
      const readFull = (data.evidence ?? []).filter((e) => e.readMethod === 'full_page').length;
      setStage('read', evidenceCount > 0 ? 'done' : 'skipped', evidenceCount > 0 ? `${readFull} of ${evidenceCount} read in full` : undefined);
      setStage('weigh', 'done');
      setStage('verdict', 'done');
      announce('Check complete.');

      renderResult(data);
      showStep('result');
      resultBox?.scrollIntoView({ behavior: 'smooth', block: 'start' });

      // P6 HISTORY decision: written only here, after a check has SUCCEEDED —
      // never on the error path above, never mid-flight. data.id is absent
      // only when the pipeline could not persist a record at all, in which
      // case there is nothing stable to link a history row to.
      if (data.id) {
        recordFactCheckHistory({
          id: data.id,
          claim: data.claim || value,
          verdict: data.verdict ?? 'unverified',
          evidenceStrength: data.evidenceStrength ?? null,
        });
      }
    } catch {
      showStep('error');
    }
  }

  // ── Render result from cloned templates + safe DOM building ──
  function cloneTemplate(id: string): DocumentFragment | null {
    const tpl = document.getElementById(id) as HTMLTemplateElement | null;
    return tpl ? (tpl.content.cloneNode(true) as DocumentFragment) : null;
  }

  function renderVerdictBadge(container: HTMLElement, verdict: string) {
    const frag = cloneTemplate('tpl-verdict-badge');
    if (!frag) return;
    const badge = frag.querySelector<HTMLElement>('[data-verdict-badge]');
    badge?.setAttribute('data-verdict', verdict);
    container.replaceChildren(frag);
    // The presentation (icon/label/colour classes) is baked into the cloned
    // markup already, per verdict, by VerdictBadge.astro rendering six
    // variants server-side would be wasteful — instead we swap the class list
    // client-side using the same lib/ui/verdict data.
    applyVerdictPresentation(container, verdict);
  }

  // Mirrors src/lib/ui/verdict.ts. Duplicated here deliberately: that module
  // is server-only (.astro imports it at build time), and this is the one
  // client script in the whole app that needs the same table at runtime. Any
  // change to verdict presentation must be made in BOTH places — the
  // dedicated test suite for this file (tests/factcheck/… widget tests) is
  // what catches drift.
  const PRESENTATION: Record<
    string,
    { label: string; icon: string; borderClass: string; glyphClass: string; description: string }
  > = {
    true: { label: 'TRUE', icon: '✓', borderClass: 'border border-success', glyphClass: 'bg-success text-canvas', description: 'True — supported by reliable evidence, as stated.' },
    false: { label: 'FALSE', icon: '✕', borderClass: 'border border-error', glyphClass: 'bg-error text-canvas', description: 'False — contradicted by reliable evidence.' },
    partly_true: { label: 'PARTLY TRUE', icon: '◐', borderClass: 'border border-warning', glyphClass: 'bg-warning text-canvas', description: 'Partly true — some of the claim holds and some does not.' },
    misleading: { label: 'MISLEADING', icon: '⚠', borderClass: 'border-2 border-verdict-misleading', glyphClass: 'text-verdict-misleading', description: 'Misleading — the facts check out but the framing does not.' },
    unverified: { label: 'UNVERIFIED', icon: '?', borderClass: 'border-2 border-mute', glyphClass: 'text-mute', description: 'Unverified — we could not establish this claim either way.' },
    needs_context: { label: 'NEEDS CONTEXT', icon: 'ⓘ', borderClass: 'border-2 border-verdict-context', glyphClass: 'text-verdict-context', description: 'Needs context — established, but incomplete without a qualification.' },
  };

  function applyVerdictPresentation(container: HTMLElement, verdict: string) {
    const p = PRESENTATION[verdict] ?? PRESENTATION.unverified;
    const badge = container.querySelector<HTMLElement>('[data-verdict-badge]');
    if (!badge) return;
    badge.className = `inline-flex items-center gap-2 rounded-sm bg-surface-card font-semibold uppercase tracking-wide text-ink px-4 py-2.5 text-sm ${p.borderClass}`;
    const glyph = badge.querySelector<HTMLElement>('[data-verdict-glyph]');
    if (glyph) {
      glyph.className = `inline-flex items-center justify-center rounded-full leading-none h-6 w-6 text-sm ${p.glyphClass}`;
      glyph.textContent = p.icon;
    }
    const label = badge.querySelector('[data-verdict-label]');
    if (label) label.textContent = p.label;
    const desc = badge.querySelector('[data-verdict-description]');
    if (desc) desc.textContent = `— ${p.description}`;
  }

  const STRENGTH: Record<string, { label: string; filled: number; description: string }> = {
    strong: { label: 'Strong', filled: 4, description: 'Multiple independent, high-quality sources agree.' },
    moderate: { label: 'Moderate', filled: 3, description: 'Corroborated, but by fewer or less independent sources.' },
    weak: { label: 'Weak', filled: 2, description: 'Thin or single-source evidence.' },
    none: { label: 'None', filled: 0, description: 'No usable evidence was found.' },
  };

  function renderStrength(container: HTMLElement, strength: string) {
    const frag = cloneTemplate('tpl-strength-meter');
    if (!frag) return;
    const s = STRENGTH[strength] ?? STRENGTH.none;
    const meter = frag.querySelector<HTMLElement>('[data-strength-meter]');
    meter?.setAttribute('data-strength', strength);
    const segments = frag.querySelectorAll<HTMLElement>('[data-strength-segment]');
    segments.forEach((seg, i) => {
      const filled = i < s.filled;
      seg.dataset.filled = String(filled);
      seg.className = `h-2.5 w-5 rounded-[2px] border ${filled ? 'border-ink bg-ink' : 'border-stone bg-transparent'}`;
    });
    const label = frag.querySelector('[data-strength-label]');
    if (label) label.textContent = s.label;
    const desc = frag.querySelector('[data-strength-description]');
    if (desc) desc.textContent = `Evidence strength: ${s.label}. ${s.description}`;
    container.replaceChildren(frag);
  }

  function renderEvidenceList(container: HTMLElement, evidence: Evidence[]) {
    container.replaceChildren();

    const heading = document.createElement('div');
    heading.className = 'mb-2 flex flex-wrap items-baseline justify-between gap-2 border-b border-hairline pb-2';
    const h2 = document.createElement('h2');
    h2.className = 'text-lg font-semibold text-ink';
    h2.textContent = `Evidence (${evidence.length})`;
    heading.appendChild(h2);
    container.appendChild(heading);

    if (evidence.length === 0) {
      const empty = document.createElement('p');
      empty.className = 'rounded-sm border border-hairline bg-surface-soft p-4 text-sm text-body';
      empty.textContent =
        'No usable sources were found. That is why the verdict is what it is — it is a result, not a missing section.';
      container.appendChild(empty);
      return;
    }

    const list = document.createElement('ul');
    list.className = 'flex flex-col divide-y divide-hairline-soft';

    const STANCE_BORDER: Record<string, string> = {
      supports: 'border-l-success',
      contradicts: 'border-l-error',
      neutral: 'border-l-mute',
      unclear: 'border-l-stone',
    };
    const STANCE_LABEL: Record<string, string> = {
      supports: 'Supports the claim',
      contradicts: 'Contradicts the claim',
      neutral: 'Context only',
      unclear: 'Unclear',
    };

    const sorted = [...evidence].sort((a, b) => (a.position ?? 0) - (b.position ?? 0));

    sorted.forEach((e, i) => {
      const stance = e.stance ?? 'unclear';
      const li = document.createElement('li');
      li.className = `border-l-[3px] py-4 pl-4 ${STANCE_BORDER[stance] ?? STANCE_BORDER.unclear}`;

      const meta = document.createElement('div');
      meta.className = 'flex flex-wrap items-center gap-x-2 gap-y-1';

      const pos = document.createElement('span');
      pos.className = 'font-mono text-sm font-bold text-mute';
      pos.textContent = `[${e.position ?? i + 1}]`;

      const pub = document.createElement('span');
      pub.className = 'text-sm font-semibold text-ink';
      pub.textContent = e.publisher;

      const stanceEl = document.createElement('span');
      stanceEl.className = 'font-mono-caption rounded-full border border-hairline bg-surface-card px-2 py-0.5 text-mute';
      stanceEl.textContent = STANCE_LABEL[stance] ?? STANCE_LABEL.unclear;

      meta.appendChild(pos);
      meta.appendChild(pub);
      meta.appendChild(stanceEl);
      li.appendChild(meta);

      const dates = document.createElement('p');
      dates.className = 'font-mono-caption mt-1.5 text-mute';
      const publishedLabel = formatEvidenceDate(e.publishedAt) ?? 'Date unknown';
      let dateText = `Published ${publishedLabel}`;
      const accessedLabel = formatEvidenceDate(e.accessedAt);
      if (accessedLabel) dateText += ` · Accessed ${accessedLabel}`;
      dateText += ` · ${e.readMethod === 'full_page' ? 'Read in full' : 'Snippet only'}`;
      dates.textContent = dateText;
      li.appendChild(dates);

      const title = document.createElement('p');
      title.className = 'mt-2 text-[15px] font-medium leading-snug text-ink';
      title.textContent = e.title;
      li.appendChild(title);

      if (e.quotedPassage) {
        const quote = document.createElement('blockquote');
        quote.className = 'mt-2 border-l-2 border-hairline pl-3 text-sm italic leading-relaxed text-body';
        quote.textContent = e.quotedPassage;
        li.appendChild(quote);
      }

      if (e.injectionFlagged) {
        const flag = document.createElement('p');
        flag.className = 'mt-2 text-xs font-semibold text-error';
        flag.textContent = '⚠ This page contained text attempting to influence the assessment. It was ignored.';
        li.appendChild(flag);
      }

      if (e.relevant === false) {
        const note = document.createElement('p');
        note.className = 'mt-2 text-xs text-mute';
        note.textContent =
          'Read, but it does not materially address the claim — it did not count toward corroboration.';
        li.appendChild(note);
      }

      const linkP = document.createElement('p');
      linkP.className = 'mt-2';
      const href = safeHref(e.url);
      if (href) {
        const a = document.createElement('a');
        a.href = href;
        a.target = '_blank';
        a.rel = 'noopener noreferrer';
        a.className = 'inline-flex min-h-11 items-center text-sm font-semibold text-primary-strong';
        a.textContent = 'Open source ↗';
        linkP.appendChild(a);
      } else {
        const span = document.createElement('span');
        span.className = 'font-mono-caption text-mute';
        span.textContent = 'Link withheld — the source URL did not pass validation';
        linkP.appendChild(span);
      }
      li.appendChild(linkP);

      list.appendChild(li);
    });

    container.appendChild(list);
  }

  function formatEvidenceDate(value?: string | null): string | null {
    if (!value) return null;
    const t = Date.parse(value);
    if (Number.isNaN(t)) return null;
    return new Date(t).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
  }

  function renderLimitations(container: HTMLElement, limitations: string[] | undefined, basis: string | undefined) {
    container.replaceChildren();
    const panel = document.createElement('section');
    panel.className = 'rounded-sm border border-hairline bg-surface-soft p-4 sm:p-5';

    const h2 = document.createElement('h2');
    h2.className = 'text-base font-semibold text-ink';
    h2.textContent = 'Limitations';
    panel.appendChild(h2);

    const basisNote = document.createElement('p');
    basisNote.className = 'mt-1.5 text-sm leading-relaxed text-body';
    basisNote.textContent =
      basis === 'certified'
        ? 'This verdict follows a published fact-checker’s own rating.'
        : basis === 'ai_assessment'
          ? 'This is an AI assessment over the sources listed above, not a certified fact-check.'
          : 'Nothing was established, so no verdict is asserted.';
    panel.appendChild(basisNote);

    const list = document.createElement('ul');
    list.className = 'mt-3 flex list-disc flex-col gap-1.5 pl-5 text-sm leading-relaxed text-body';
    const items = [
      ...(limitations ?? []).filter((l) => typeof l === 'string' && l.trim() !== ''),
      'Sources were read at the time of the check; a page can change afterwards.',
      'Coverage is limited to sources reachable and readable from the public web.',
    ];
    for (const l of items) {
      const li = document.createElement('li');
      li.textContent = l;
      list.appendChild(li);
    }
    panel.appendChild(list);

    container.appendChild(panel);
  }

  function renderShare(container: HTMLElement, id: string | undefined) {
    container.replaceChildren();
    if (!id) return;

    const wrap = document.createElement('div');
    wrap.className = 'flex flex-wrap items-center gap-2';
    wrap.dataset.factcheckId = id;

    const copyBtn = document.createElement('button');
    copyBtn.type = 'button';
    copyBtn.className = 'btn-pill-secondary inline-flex min-h-11 cursor-pointer items-center px-4 text-sm';
    copyBtn.textContent = 'Copy link';

    const status = document.createElement('span');
    status.setAttribute('role', 'status');
    status.setAttribute('aria-live', 'polite');
    status.className = 'font-mono-caption text-mute';

    copyBtn.addEventListener('click', async () => {
      const url = new URL(`/fact-check/${id}`, window.location.origin).toString();
      try {
        await navigator.clipboard.writeText(url);
        status.textContent = 'Link copied.';
      } catch {
        status.textContent = `Copy this link: ${url}`;
      }
    });

    const open = document.createElement('a');
    open.href = `/fact-check/${id}`;
    open.className = 'inline-flex min-h-11 items-center px-2 text-sm font-semibold text-primary-strong';
    open.textContent = 'Open the full result ↗';

    wrap.appendChild(copyBtn);
    wrap.appendChild(open);
    wrap.appendChild(status);
    container.appendChild(wrap);
  }

  function renderResult(data: FactCheckResult) {
    const verdictSlot = document.getElementById('result-verdict-slot');
    const strengthSlot = document.getElementById('result-strength-slot');
    const basisNote = document.getElementById('result-basis-note');
    const summary = document.getElementById('result-summary');
    const evidenceSlot = document.getElementById('result-evidence-slot');
    const limitationsSlot = document.getElementById('result-limitations-slot');
    const shareSlot = document.getElementById('result-share-slot');

    if (verdictSlot) renderVerdictBadge(verdictSlot, data.verdict ?? 'unverified');
    if (strengthSlot) renderStrength(strengthSlot, data.evidenceStrength ?? 'none');

    if (basisNote) {
      basisNote.textContent =
        data.basis === 'certified'
          ? `Reviewed by ${data.evidence?.[0]?.publisher ?? 'a published fact-checker'}.`
          : data.basis === 'ai_assessment'
            ? 'AI assessment based on the sources below — not a certified fact-check.'
            : '';
    }

    if (summary) summary.textContent = data.summary || data.explanation || '';
    if (evidenceSlot) renderEvidenceList(evidenceSlot, data.evidence ?? []);
    if (limitationsSlot) renderLimitations(limitationsSlot, data.limitations, data.basis);
    if (shareSlot) renderShare(shareSlot, data.id);
  }

  // ── Retry from the error state re-runs the last submitted value. ──
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) return;
    if (target.closest('[data-nz-retry="factcheck"]')) {
      showStep('input');
    }
  });

  // ── Arrived from the homepage hero with ?claim= ──
  const params = new URLSearchParams(window.location.search);
  const initial = params.get('claim');
  if (initial && claimInput) {
    claimInput.value = initial.slice(0, 2000);
    goToConfirmOrCheck();
  }
</script>
