---
---
<section id="fact-checker" class="w-full py-12 bg-canvas border-b border-hairline transition-colors duration-200">
  <div class="max-w-[1400px] mx-auto px-4 sm:px-6">
    <div class="max-w-4xl mx-auto">

      <!-- Section Header -->
      <div class="flex flex-col items-center text-center mb-8">
        <span class="font-mono-caption text-primary-strong mb-2 font-semibold">FACT CHECK ENGINE</span>
        <h2 class="text-2xl sm:text-4xl font-semibold text-ink tracking-[-1.28px] mb-3">
          Instant News Verification
        </h2>
        <p class="text-sm sm:text-base text-body max-w-xl">
          NewzWale checks claims against published fact-checkers first, then live web sources, and only issues a verdict when the evidence supports one.
        </p>
      </div>

      <!-- Verification Tool Panel -->
      <div class="bg-surface-soft border border-hairline rounded-lg p-4 sm:p-6 shadow-stacked-md">

        <!-- Input Tabs -->
        <div role="tablist" aria-label="Fact check input type" class="flex items-center gap-2 border-b border-hairline pb-3 mb-4 overflow-x-auto text-xs font-medium">
          <button type="button" role="tab" id="tab-text" aria-controls="panel-text" aria-selected="true" data-tab="text" class="tab-btn active px-3 py-1.5 font-semibold text-ink bg-surface-elevated border border-hairline rounded-full shadow-stacked-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-strong">
            <span aria-hidden="true">📝</span> Text / Claim
          </button>
          <button type="button" role="tab" id="tab-url" aria-controls="panel-url" aria-selected="false" data-tab="url" class="tab-btn px-3 py-1.5 text-body hover:text-ink rounded-full focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-strong">
            <span aria-hidden="true">🔗</span> Article URL
          </button>
          <button type="button" role="tab" id="tab-image" aria-controls="panel-image" aria-selected="false" data-tab="image" class="tab-btn px-3 py-1.5 text-body hover:text-ink rounded-full focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-strong">
            <span aria-hidden="true">🖼️</span> Image / Screenshot
          </button>
        </div>

        <!-- Input Area -->
        <div id="input-container" class="space-y-3 mb-4">
          <div id="panel-text" role="tabpanel" aria-labelledby="tab-text" class="tab-panel space-y-3">
            <label for="claim-text" class="sr-only">Headline or claim to fact check</label>
            <textarea
              id="claim-text"
              rows="3"
              autocomplete="off"
              placeholder="Paste news headline or claim to verify (e.g. 'RBI keeps repo rate steady at 6.5%')"
              class="w-full bg-surface-elevated border border-hairline rounded-md p-3 text-sm text-ink placeholder:text-mute focus:outline-none focus:ring-1 focus:ring-primary-strong resize-none"
            ></textarea>

            <!-- Pre-set Quick Demos -->
            <div class="flex items-center gap-2 overflow-x-auto pb-1 text-xs">
              <span class="text-mute font-mono-caption text-[10px] shrink-0">Try Demos:</span>
              <button type="button" class="demo-prompt-btn px-2.5 py-1 bg-surface-elevated border border-hairline hover:border-primary rounded-full text-body transition-colors shrink-0">
                "RBI Repo Rate FY27"
              </button>
              <button type="button" class="demo-prompt-btn px-2.5 py-1 bg-surface-elevated border border-hairline hover:border-primary rounded-full text-body transition-colors shrink-0">
                "Viral WhatsApp 2000 Note Bank Holiday"
              </button>
              <button type="button" class="demo-prompt-btn px-2.5 py-1 bg-surface-elevated border border-hairline hover:border-primary rounded-full text-body transition-colors shrink-0">
                "ISRO INSAT-3DS Satellite Launch"
              </button>
            </div>
          </div>

          <div id="panel-url" role="tabpanel" aria-labelledby="tab-url" class="tab-panel" hidden>
            <label for="claim-url" class="sr-only">Article URL to fact check</label>
            <input
              id="claim-url"
              type="url"
              inputmode="url"
              autocomplete="url"
              spellcheck="false"
              placeholder="https://example.com/article-to-check"
              class="w-full bg-surface-elevated border border-hairline rounded-md p-3 text-sm text-ink placeholder:text-mute focus:outline-none focus:ring-1 focus:ring-primary-strong"
            />
          </div>

          <div id="panel-image" role="tabpanel" aria-labelledby="tab-image" class="tab-panel" hidden>
            <p class="text-sm text-mute p-4 bg-surface-elevated border border-dashed border-hairline rounded-md text-center">
              Image / screenshot checking is coming soon.
            </p>
          </div>
        </div>

        <!-- Verification Action Button -->
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2 text-xs text-mute">
            <svg class="w-3.5 h-3.5 text-primary-strong" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
            Checks published fact-checkers, then live web sources
          </div>

          <button
            type="button"
            id="verify-submit-btn"
            class="px-5 py-2.5 bg-primary-strong hover:bg-primary-pressed text-on-primary text-xs font-bold rounded-md shadow-stacked-sm transition-colors flex items-center gap-2 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
          >
            <span id="btn-spinner" class="hidden w-3.5 h-3.5 border-2 border-on-primary border-t-transparent rounded-full animate-spin" aria-hidden="true"></span>
            <span id="verify-submit-label">Check Claim</span>
          </button>
        </div>

        <!-- Error state -->
        <p id="verify-error" role="alert" class="hidden mt-4 text-xs text-error bg-error/10 border border-error/30 rounded-md p-3"></p>

        <!-- Output Verdict Card -->
        <div id="verdict-card" aria-live="polite" class="hidden mt-6 pt-6 border-t border-hairline animate-fade-in space-y-6">

          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3 p-4 rounded-md bg-surface-elevated border border-hairline">
            <span id="verdict-badge" class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider shadow-stacked-sm">
              <!-- Injected via JS -->
            </span>
            <div id="verdict-basis-note" class="text-xs text-mute"></div>
          </div>

          <!-- Short Verdict Explanation -->
          <div>
            <h4 class="text-xs font-mono-caption text-mute mb-1">EXPLANATION</h4>
            <div id="verdict-short-answer" class="text-sm font-medium text-ink bg-surface-elevated p-4 rounded-md border border-hairline leading-relaxed shadow-stacked-sm">
              <!-- Injected via JS -->
            </div>
          </div>

          <!-- Sources -->
          <div>
            <h4 class="text-xs font-mono-caption text-mute mb-2">SOURCES CHECKED</h4>
            <div id="sources-list" class="grid grid-cols-1 sm:grid-cols-2 gap-2">
              <!-- Injected via JS -->
            </div>
          </div>

        </div>

      </div>

    </div>
  </div>
</section>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
  const panels = document.querySelectorAll<HTMLElement>('.tab-panel');
  const submitBtn = document.getElementById('verify-submit-btn') as HTMLButtonElement;
  const claimText = document.getElementById('claim-text') as HTMLTextAreaElement;
  const claimUrl = document.getElementById('claim-url') as HTMLInputElement;
  const verdictCard = document.getElementById('verdict-card');
  const verdictBadge = document.getElementById('verdict-badge');
  const verdictBasisNote = document.getElementById('verdict-basis-note');
  const verdictShortAnswer = document.getElementById('verdict-short-answer');
  const sourcesList = document.getElementById('sources-list');
  const btnSpinner = document.getElementById('btn-spinner');
  const submitLabel = document.getElementById('verify-submit-label');
  const errorBox = document.getElementById('verify-error');

  let activeTab: 'text' | 'url' | 'image' = 'text';

  // The pill look is plain Tailwind utilities, not a `.tab-btn.active` CSS
  // rule - so switching tabs has to move these classes itself, not just an
  // inert "active" flag, or the highlight never leaves the first tab.
  const ACTIVE_CLASSES = ['font-semibold', 'text-ink', 'bg-surface-elevated', 'border', 'border-hairline', 'shadow-stacked-sm'];
  const INACTIVE_CLASSES = ['text-body', 'hover:text-ink'];

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const tab = btn.getAttribute('data-tab') as 'text' | 'url' | 'image';
      activeTab = tab;
      buttons.forEach((b) => {
        const isActive = b === btn;
        b.classList.toggle('active', isActive);
        b.classList.remove(...ACTIVE_CLASSES, ...INACTIVE_CLASSES);
        b.classList.add(...(isActive ? ACTIVE_CLASSES : INACTIVE_CLASSES));
        b.setAttribute('aria-selected', String(isActive));
      });
      panels.forEach((p) => { p.hidden = p.id !== `panel-${tab}`; });
      submitBtn.disabled = tab === 'image';
    });
  });

  document.querySelectorAll('.demo-prompt-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const prompt = (e.target as HTMLElement).innerText.replace(/"/g, '');
      if (prompt.includes('RBI Repo Rate')) {
        claimText.value = "RBI keeps repo rate unchanged at 6.5% for FY27 projecting 7.2% GDP growth.";
      } else if (prompt.includes('WhatsApp')) {
        claimText.value = "Emergency bank holiday declared across India starting tomorrow for 3 days due to currency audit.";
      } else {
        claimText.value = "ISRO successfully launches INSAT-3DS weather satellite from Sriharikota.";
      }
    });
  });

  // KEY MAPPING ONLY — no visual redesign. The UI is locked until the design
  // direction is approved.
  //
  // This had to change: /api/factcheck now returns the six canonical wire
  // values, and the old map keyed on 'verified'/'insufficient_evidence'. An
  // unmatched key fell through to the insufficient_evidence entry, so a TRUE
  // verdict rendered as "Not enough evidence to judge" — the API telling the
  // truth and the interface contradicting it.
  //
  // Styling reuses EXISTING tokens; no new colours are introduced. The final
  // treatment (including the unresolved brand-coral vs MISLEADING-orange
  // collision, and the WCAG requirement that verdicts never rely on colour
  // alone) belongs to NEWZWALE_DESIGN_DIRECTION.md.
  const VERDICTS: Record<string, { label: string; badgeClass: string; icon: string }> = {
    true: { label: 'True', badgeClass: 'bg-success/15 text-success border border-success/40', icon: '✓' },
    false: { label: 'False', badgeClass: 'bg-error/15 text-error border border-error/40', icon: '✕' },
    partly_true: { label: 'Partly true', badgeClass: 'bg-warning/15 text-warning border border-warning/40', icon: '◐' },
    misleading: { label: 'Misleading', badgeClass: 'bg-warning/25 text-warning border-2 border-warning/60', icon: '⚠' },
    unverified: { label: 'Not enough evidence', badgeClass: 'bg-surface-card text-mute border border-hairline', icon: '?' },
    needs_context: { label: 'Needs context', badgeClass: 'bg-primary-strong/10 text-primary-strong border border-primary-strong/40', icon: 'ⓘ' },
  };

  // Evidence URLs originate from third-party APIs (Tavily, Google Fact Check).
  // The server already filters them, but this is the last line before the
  // value reaches `a.href`, where a `javascript:` URL would be script
  // execution in the user's session. Both sides check: "the evidence provider
  // was compromised" is precisely the threat model an evidence-first product
  // has to survive. Mirrors isSafeUrl in src/lib/url.ts.
  function isSafeHref(value: string): boolean {
    try {
      const { protocol } = new URL(value);
      return protocol === 'http:' || protocol === 'https:';
    } catch {
      return false;
    }
  }

  function renderSources(evidence: { title: string; url: string; publisher: string }[]) {
    if (!sourcesList) return;
    sourcesList.innerHTML = '';
    if (evidence.length === 0) {
      const p = document.createElement('p');
      p.className = 'text-xs text-mute col-span-2';
      p.textContent = 'No sources to show.';
      sourcesList.appendChild(p);
      return;
    }
    for (const e of evidence) {
      const linkable = isSafeHref(e.url);

      // An unsafe URL still gets its source listed - suppressing it entirely
      // would hide from the reader that the check read something it could not
      // vouch for. It is rendered as inert text rather than a clickable link.
      const a = document.createElement(linkable ? 'a' : 'div');
      if (linkable && a instanceof HTMLAnchorElement) {
        a.href = e.url;
        a.target = '_blank';
        a.rel = 'noopener noreferrer';
      }
      a.className = 'p-3 bg-surface-elevated border border-hairline rounded-md hover:border-primary transition-colors flex items-center justify-between gap-2 group';

      const title = document.createElement('span');
      title.className = 'font-medium text-ink group-hover:text-primary-strong';
      title.textContent = e.title;

      const publisher = document.createElement('span');
      publisher.className = 'font-mono text-[10px] text-mute shrink-0';
      publisher.textContent = linkable ? `${e.publisher} ↗` : `${e.publisher} (link withheld)`;

      a.appendChild(title);
      a.appendChild(publisher);
      sourcesList.appendChild(a);
    }
  }

  submitBtn?.addEventListener('click', async () => {
    const body =
      activeTab === 'url' ? { url: claimUrl.value.trim() } : { claim: claimText.value.trim() };
    if (('url' in body && !body.url) || ('claim' in body && !body.claim)) return;

    btnSpinner?.classList.remove('hidden');
    submitBtn.disabled = true;
    if (submitLabel) submitLabel.textContent = 'Checking…';
    errorBox?.classList.add('hidden');
    verdictCard?.classList.add('hidden');

    try {
      const res = await fetch('/api/factcheck', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      const data = (await res.json()) as {
        verdict?: string;
        explanation?: string;
        basis?: string;
        evidence?: { title: string; url: string; publisher: string }[];
        error?: string;
      };

      if (!res.ok) {
        if (errorBox) {
          errorBox.textContent = data.error || 'Could not check that claim.';
          errorBox.classList.remove('hidden');
        }
        return;
      }

      // Unknown verdict falls back to "not enough evidence" — the only safe
      // default. Never assume a verdict the server did not send.
      const style = VERDICTS[data.verdict ?? ''] ?? VERDICTS.unverified;
      if (verdictBadge) {
        verdictBadge.className = `inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider shadow-stacked-sm ${style.badgeClass}`;
        verdictBadge.textContent = `${style.icon} ${style.label}`;
      }

      if (verdictBasisNote) {
        if (data.basis === 'certified') {
          verdictBasisNote.textContent = `Reviewed by ${data.evidence?.[0]?.publisher ?? 'a published fact-checker'}.`;
        } else if (data.basis === 'ai_assessment') {
          verdictBasisNote.textContent = 'AI assessment based on the sources below — not a certified fact-check.';
        } else {
          verdictBasisNote.textContent = '';
        }
      }

      if (verdictShortAnswer) verdictShortAnswer.textContent = data.explanation || '';
      renderSources(data.evidence ?? []);

      verdictCard?.classList.remove('hidden');
    } catch {
      if (errorBox) {
        errorBox.textContent = 'Verification service unavailable right now.';
        errorBox.classList.remove('hidden');
      }
    } finally {
      btnSpinner?.classList.add('hidden');
      submitBtn.disabled = activeTab === 'image';
      if (submitLabel) submitLabel.textContent = 'Check Claim';
    }
  });
</script>
