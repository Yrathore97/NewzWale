---
import type { Article } from '../lib/news/types';
import type { ApiArticle } from '../lib/news/read';
import { prepareArticles } from '../lib/news/feed';
import { DEFAULT_LANGUAGE } from '../lib/news/languages';
import ArticleCard from './ArticleCard.astro';
import ArticleGrid from './news/ArticleGrid.astro';
import EmptyState from './shared/EmptyState.astro';

interface Props {
  slug: string;
  label: string;
  language?: string;
  excludeUrls?: string[];
}

const { slug, label, language = DEFAULT_LANGUAGE, excludeUrls = [] } = Astro.props;

const RAIL_SIZE = 4;

/** Reads /api/v1/news (D1), NOT the legacy /api/news.
 *
 *  WHY THIS MATTERS FOR A RAIL SPECIFICALLY. /api/news answers from a live
 *  provider chain (NewsData -> Guardian -> RSS) on a cache miss. RSS is the
 *  chain's floor for exactly the situation this component is most likely to
 *  hit — four category-specific rails rendering on one homepage load, right
 *  when NewsData's shared quota (see wrangler.jsonc's cron note) is under the
 *  most pressure. `fetchRssFallback()` takes NO category argument: every
 *  article it returns is hardcoded `category: 'top'`. When the chain falls
 *  that far, every rail that fell through receives the IDENTICAL undifferen-
 *  tiated feed and renders it under its own label — Sports, Business,
 *  Technology and Health all show the same four "top" articles, in the same
 *  order. Confirmed live, not hypothetical: a design review of the deployed
 *  site found exactly this.
 *
 *  /api/v1/news reads D1 rows already ingested and correctly categorised by
 *  the scheduled job — it never touches a provider on the read path, so it
 *  cannot degrade to a shared feed. Confirmed against the live database
 *  before this change: business/sports/technology/health each have distinct,
 *  real article counts (from 3 to 263 at time of writing) — thin for a young
 *  or low-volume category, never wrong.
 *
 *  This is also the exact migration read.ts's own module comment anticipates
 *  ("/api/news is deliberately NOT routed through here... because
 *  NewsFeed.astro parses that shape today") — that reasoning names
 *  NewsFeed.astro specifically, not this component. A rail has no "load
 *  more" pagination contract to preserve. */
let apiArticles: ApiArticle[] = [];
try {
  const res = await fetch(
    new URL(
      `/api/v1/news?category=${encodeURIComponent(slug)}&language=${encodeURIComponent(language)}&limit=${RAIL_SIZE + excludeUrls.length}`,
      Astro.url,
    ),
  );
  if (res.ok) apiArticles = ((await res.json()) as { data: ApiArticle[] }).data ?? [];
} catch {
  /* falls through to the empty state below, which is rendered rather than
     vanishing - see the section comment. */
}

// D1's summary/publishedAt are nullable (a publisher can omit both, and P8's
// migration made an unknown publish date NULL rather than a guess). `Article`
// predates that nullability, so this is the same projection ArticleCard
// already renders elsewhere: an absent summary is an empty string, never
// invented text, and prepareArticles' date sort already treats an unparsable
// string as "unknown" — see feed.ts's `time()`.
const articles: Article[] = apiArticles.map((a) => ({
  id: a.id,
  title: a.title,
  url: a.url,
  summary: a.summary ?? '',
  imageUrl: a.imageUrl,
  source: a.source,
  category: a.category,
  publishedAt: a.publishedAt ?? '',
}));

const exclude = new Set(excludeUrls);
const rail = prepareArticles(articles)
  .filter((a) => !exclude.has(a.url))
  .slice(0, RAIL_SIZE);
---

<!-- The rail used to render NOTHING when it had no articles (audit §5.6: the
     category rail was the one surface that simply vanished). A section the
     reader has explicitly asked to see, disappearing without a word, is
     indistinguishable from a bug. It now always renders its heading and says
     what is empty. -->
<section
  data-topic-section={label}
  class="w-full border-b border-hairline-soft py-8 last:border-b-0"
>
  <div class="mx-auto max-w-[1400px] px-4 sm:px-6">
    <div class="mb-5 flex items-center justify-between gap-4 border-b border-hairline pb-4">
      <h2 class="flex items-center gap-2 text-xl font-semibold tracking-[-0.6px] text-ink sm:text-2xl">
        <span class="h-2 w-2 rounded-full bg-primary" aria-hidden="true"></span>
        {label}
      </h2>
      <a
        href={`/category/${slug}`}
        class="flex min-h-11 shrink-0 items-center gap-1 rounded-sm text-xs font-semibold text-primary-strong hover:text-primary-pressed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-strong"
      >
        View all {label}
        <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
      </a>
    </div>

    {
      rail.length === 0 ? (
        <EmptyState
          title={`No ${label} headlines right now`}
          description={`Publisher feeds returned nothing for ${label.toLowerCase()} in the current window. Other sections on this page are still updating.`}
          actionLabel={`Open ${label}`}
          actionHref={`/category/${slug}`}
        />
      ) : (
        <ArticleGrid variant="rail">
          {rail.map((article) => (
            <ArticleCard article={article} />
          ))}
        </ArticleGrid>
      )
    }
  </div>
</section>
