---
import type { Article, NewsPage } from '../lib/news/types';
import { prepareArticles } from '../lib/news/feed';
import { DEFAULT_LANGUAGE } from '../lib/news/languages';
import ArticleCard from './ArticleCard.astro';
import ArticleGrid from './news/ArticleGrid.astro';
import EmptyState from './shared/EmptyState.astro';

interface Props {
  slug: string;
  label: string;
  language?: string;
  excludeUrls?: string[];
}

const { slug, label, language = DEFAULT_LANGUAGE, excludeUrls = [] } = Astro.props;

const RAIL_SIZE = 4;

let articles: Article[] = [];
try {
  const res = await fetch(
    new URL(
      `/api/news?category=${encodeURIComponent(slug)}&language=${encodeURIComponent(language)}`,
      Astro.url,
    ),
  );
  if (res.ok) articles = ((await res.json()) as NewsPage).articles ?? [];
} catch {
  /* falls through to the empty state below, which is rendered rather than
     vanishing - see the section comment. */
}

const exclude = new Set(excludeUrls);
articles = prepareArticles(articles).filter((a) => !exclude.has(a.url)).slice(0, RAIL_SIZE);
---

<!-- The rail used to render NOTHING when it had no articles (audit §5.6: the
     category rail was the one surface that simply vanished). A section the
     reader has explicitly asked to see, disappearing without a word, is
     indistinguishable from a bug. It now always renders its heading and says
     what is empty. -->
<section
  data-topic-section={label}
  class="w-full border-b border-hairline-soft py-8 last:border-b-0"
>
  <div class="mx-auto max-w-[1400px] px-4 sm:px-6">
    <div class="mb-5 flex items-center justify-between gap-4 border-b border-hairline pb-4">
      <h2 class="flex items-center gap-2 text-xl font-semibold tracking-[-0.6px] text-ink sm:text-2xl">
        <span class="h-2 w-2 rounded-full bg-primary" aria-hidden="true"></span>
        {label}
      </h2>
      <a
        href={`/category/${slug}`}
        class="flex min-h-11 shrink-0 items-center gap-1 rounded-sm text-xs font-semibold text-primary-strong hover:text-primary-pressed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-strong"
      >
        View all {label}
        <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
      </a>
    </div>

    {
      articles.length === 0 ? (
        <EmptyState
          title={`No ${label} headlines right now`}
          description={`Publisher feeds returned nothing for ${label.toLowerCase()} in the current window. Other sections on this page are still updating.`}
          actionLabel={`Open ${label}`}
          actionHref={`/category/${slug}`}
        />
      ) : (
        <ArticleGrid variant="rail">
          {articles.map((article) => (
            <ArticleCard article={article} />
          ))}
        </ArticleGrid>
      )
    }
  </div>
</section>
