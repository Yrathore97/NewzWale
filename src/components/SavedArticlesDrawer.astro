---
import Dialog from './shared/Dialog.astro';

/** Saved-articles overlay.
 *
 *  Two fixes over the previous version:
 *
 *  A-05 — it was an <aside> with no role, no aria-modal, no focus trap and no
 *  focus return. It is now a shared <Dialog>, so all of that is inherited
 *  rather than reimplemented.
 *
 *  S-12 — hrefs came straight out of localStorage and were assigned to
 *  `a.href` unvalidated. localStorage is attacker-writable through any XSS on
 *  the origin, and `javascript:` in an href is script execution. Every URL now
 *  goes through safeHref() at the render boundary.
 *
 *  The /saved page remains the canonical full view; this is the quick look.
 */
---

<Dialog id="saved-drawer" title="Saved articles" variant="drawer-right">
  <p id="saved-drawer-empty" class="text-sm text-mute">
    Nothing saved yet. Use the Save button on any story.
  </p>

  <div id="saved-drawer-list" class="flex flex-col gap-3"></div>

  <p class="font-mono-caption mt-6 border-t border-hairline-soft pt-3 text-mute">
    Stored on this device · not synced
  </p>

  <a
    href="/saved"
    class="mt-3 inline-flex min-h-11 items-center text-sm font-semibold text-primary-strong"
  >
    Open the full saved list →
  </a>
</Dialog>

<script>
  import { safeHref } from '../lib/url';

  const list = document.getElementById('saved-drawer-list');
  const empty = document.getElementById('saved-drawer-empty');

  // The trigger lives in the masthead, a separate component. Kept as an event
  // so neither component reaches into the other's DOM.
  window.addEventListener('nz-saved-drawer-toggle', () => {
    window.NZDialog?.('saved-drawer')?.toggle(
      document.getElementById('saved-drawer-toggle'),
    );
  });

  function render() {
    if (!list || !empty) return;
    const saved = window.NZ.getSaved();
    empty.hidden = saved.length > 0;

    // createElement + textContent throughout. Never innerHTML: headlines are
    // publisher-supplied strings.
    list.replaceChildren();

    for (const article of saved) {
      const href = safeHref(article.href);

      const card = document.createElement('div');
      card.className = 'border border-hairline rounded-sm p-3';

      // An unsafe or malformed URL still shows the headline the reader saved —
      // silently dropping the row would look like data loss — but it is not
      // turned into a link.
      const title = document.createElement(href ? 'a' : 'p');
      title.className = 'block text-sm font-semibold text-ink mb-1.5';
      title.textContent = article.headline;
      if (href && title instanceof HTMLAnchorElement) {
        title.href = href;
        title.target = '_blank';
        title.rel = 'noopener noreferrer';
        title.classList.add('hover:text-primary-strong');
      }

      const removeBtn = document.createElement('button');
      removeBtn.type = 'button';
      removeBtn.className =
        'min-h-11 text-xs font-medium text-primary-strong bg-transparent border-none cursor-pointer p-0';
      removeBtn.textContent = 'Remove';
      removeBtn.addEventListener('click', () =>
        window.NZ.toggleSaved(article.href, article.headline),
      );

      card.appendChild(title);
      card.appendChild(removeBtn);
      list.appendChild(card);
    }
  }

  window.addEventListener('nz-saved-changed', render);
  render();
</script>
