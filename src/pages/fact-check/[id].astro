---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import MastheadInfoStrip from '../../components/MastheadInfoStrip.astro';
import Footer from '../../components/Footer.astro';
import VerdictBadge from '../../components/factcheck/VerdictBadge.astro';
import EvidenceStrengthMeter from '../../components/factcheck/EvidenceStrengthMeter.astro';
import EvidenceList from '../../components/factcheck/EvidenceList.astro';
import LimitationsPanel from '../../components/factcheck/LimitationsPanel.astro';
import ShareResult from '../../components/factcheck/ShareResult.astro';
import type { EvidenceRecord, FactCheckWithEvidence } from '../../lib/db/repositories/fact-checks';
import type { Evidence } from '../../lib/factcheck/types';
import type { ApiResponseBody } from '../../lib/api/response';
import { VERDICT_PRESENTATION } from '../../lib/ui/verdict';

// P5: "/fact-check/[id] — Permalink to one completed check". Reads
// /api/v1/factcheck/[id], which reuses FactCheckRepository.findById — the
// SAME append-only record a reader saw when the check ran. Nothing here can
// mutate it; there is no update/delete path on this table.
export const prerender = false;

const { id } = Astro.params;

let result: FactCheckWithEvidence | null = null;

if (id) {
  try {
    const res = await fetch(new URL(`/api/v1/factcheck/${encodeURIComponent(id)}`, Astro.url));
    if (res.ok) {
      const body = (await res.json()) as ApiResponseBody<FactCheckWithEvidence>;
      if ('data' in body) result = body.data;
    }
  } catch {
    // result stays null; falls through to 404 below
  }
}

if (!result) {
  return new Response(null, { status: 404 });
}

const { factCheck, evidence: persistedEvidence } = result;

const presentation = VERDICT_PRESENTATION[factCheck.verdict] ?? VERDICT_PRESENTATION.unverified;

/** The persisted stance vocabulary ('supporting'/'contradicting'/'contextual',
 *  EvidenceRecord) and the live-pipeline vocabulary ('supports'/'contradicts'/
 *  'neutral'/'unclear', Evidence in schema.ts) are two different, both
 *  intentional, naming schemes for the same three-way distinction — the D1
 *  column was named to match DESIGN_DIRECTION §2.3's stance treatment, the
 *  pipeline type predates that doc. Mapped here, at the render boundary,
 *  rather than changing either one: this page is presentation, not storage or
 *  the evidence engine. */
const STANCE_MAP: Record<EvidenceRecord['stance'], Evidence['stance']> = {
  supporting: 'supports',
  contradicting: 'contradicts',
  contextual: 'neutral',
};

const evidence: Evidence[] = persistedEvidence.map((e) => ({
  title: e.title,
  url: e.url,
  publisher: e.publisher,
  position: e.position,
  tier: e.tierAtCheck,
  stance: STANCE_MAP[e.stance],
  publishedAt: e.publishedAt,
  accessedAt: e.accessedAt,
  quotedPassage: e.quotedPassage ?? undefined,
  readMethod: e.readMethod,
  injectionFlagged: e.injectionFlagged,
  relevant: e.relevance !== 'low',
}));

// OG tags per verdict: title and description vary with the actual result,
// so a shared link preview shows what was found rather than a generic label.
const ogTitle = `${presentation.label}: ${factCheck.claim} | NewzWale Fact Check`;
const ogDescription = factCheck.summary || factCheck.claim;
---

<Layout title={ogTitle} description={ogDescription}>
  <Navbar />
  <MastheadInfoStrip />

  <main id="main" class="flex-1 bg-surface-soft py-8">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <nav aria-label="Breadcrumb" class="mb-4">
        <ol class="font-mono-caption flex items-center gap-2 text-mute">
          <li><a href="/" class="hover:text-primary-strong">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/fact-check" class="hover:text-primary-strong">Fact Check</a></li>
          <li aria-hidden="true">/</li>
          <li class="font-semibold text-ink">Result</li>
        </ol>
      </nav>

      <p class="mb-2 text-sm text-mute">Claim</p>
      <h1 class="mb-4 text-xl font-semibold leading-snug text-ink sm:text-2xl">{factCheck.claim}</h1>

      <div aria-live="polite" class="flex flex-col gap-6">
        <div
          class="flex flex-col items-start justify-between gap-3 rounded-sm border border-hairline bg-surface-elevated p-4 sm:flex-row sm:items-center"
        >
          <VerdictBadge verdict={factCheck.verdict} size="large" />
          <EvidenceStrengthMeter strength={factCheck.evidenceStrength} />
        </div>

        {
          factCheck.basis === 'certified' && evidence[0] && (
            <p class="text-sm text-mute">Reviewed by {evidence[0].publisher}.</p>
          )
        }
        {
          factCheck.basis === 'ai_assessment' && (
            <p class="text-sm text-mute">
              AI assessment based on the sources below — not a certified fact-check.
            </p>
          )
        }

        <div>
          <h2 class="font-mono-caption mb-1 text-mute">Summary</h2>
          <div
            class="rounded-sm border border-hairline bg-surface-elevated p-4 text-sm font-medium leading-relaxed text-ink shadow-stacked-sm"
          >
            {factCheck.summary}
          </div>
        </div>

        <EvidenceList evidence={evidence} />

        <LimitationsPanel limitations={factCheck.limitations} basis={factCheck.basis} />

        <ShareResult factCheckId={factCheck.id} />

        <p class="border-t border-hairline pt-4 text-xs text-mute">
          Checked{' '}
          {new Date(factCheck.checkedAt ?? '').toLocaleDateString('en-IN', {
            month: 'short',
            day: 'numeric',
            year: 'numeric',
          })}
          · <a href="/methodology" class="underline hover:no-underline">How we checked this</a>
        </p>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  // Successful load of a persisted result is exactly the moment P6's history
  // decision applies: record it on this device, once, if it is not already
  // there. The fact-check pipeline and its D1 record are untouched by this —
  // it only reads what the page already rendered.
  import { recordFactCheckHistory } from '../../lib/history/factcheck-history';

  const root = document.querySelector('[aria-live="polite"]');
  const id = window.location.pathname.split('/').filter(Boolean).pop();
  const verdictEl = root?.querySelector<HTMLElement>('[data-verdict-badge]');
  const strengthEl = root?.querySelector<HTMLElement>('[data-strength-meter]');
  const claim = document.querySelector('h1')?.textContent ?? '';

  if (id && verdictEl) {
    recordFactCheckHistory({
      id,
      claim,
      verdict: verdictEl.dataset.verdict ?? 'unverified',
      evidenceStrength: strengthEl?.dataset.strength ?? null,
      checkedAt: new Date().toISOString(),
    });
  }
</script>
