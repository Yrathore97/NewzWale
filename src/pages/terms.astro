---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import MastheadInfoStrip from '../components/MastheadInfoStrip.astro';
import Footer from '../components/Footer.astro';

export const prerender = true;

const sections = [
  {
    heading: 'Acceptance of Terms',
    body: 'By accessing or using the NewzWale website and services, you agree to be bound by these Terms & Conditions and all applicable laws and regulations. If you do not agree with any part of these terms, you must discontinue use of the service immediately.'
  },
  {
    heading: 'Use of Service',
    body: 'NewzWale provides news aggregation and automated fact-checking for personal, non-commercial use. Headlines are gathered in the language you select and always link to the original publisher; the service does not translate content or generate its own article text. You agree not to misuse the service, attempt unauthorized access, scrape content at scale, or use the platform for any unlawful purpose.'
  },
  {
    heading: 'Editorial Independence & Accuracy',
    body: 'Headlines are aggregated from third-party news providers and public RSS feeds. Fact-check verdicts are produced automatically from published fact-checks and live web sources, assessed with the help of a language model and constrained by deterministic rules. Automated assessment may occasionally be wrong, and a verdict is a summary of the evidence found at that moment, not a guarantee. Content is provided on an "as is" basis without warranties of any kind.'
  },
  {
    heading: 'Intellectual Property',
    body: 'The NewzWale name, logo, and interface design are the intellectual property of NewzWale. Headlines, extracts, and images shown in the feed remain the property of their respective publishers and are displayed with attribution and a link to the source. NewzWale does not host article bodies.'
  },
  {
    heading: 'Your Submissions',
    body: 'NewzWale has no user accounts and no sign-in. When you submit a claim or URL to the fact-checker, you grant NewzWale a non-exclusive license to process it for the purpose of producing and displaying a fact-check verdict. Do not submit personal or confidential information through the fact-checker.'
  },
  {
    heading: 'Third-Party Links & Content',
    body: 'NewzWale may link to external websites or display content from third-party sources. We are not responsible for the availability, accuracy, or privacy practices of external sites. Accessing third-party content is done at your own discretion and risk.'
  },
  {
    heading: 'Limitation of Liability',
    body: 'To the maximum extent permitted by law, NewzWale, its operators, and its affiliates shall not be liable for any indirect, incidental, special, consequential, or punitive damages arising from your use of or inability to use the service.'
  },
  {
    heading: 'Governing Law & Contact',
    body: 'These terms are governed by the laws of India. Any disputes shall be subject to the exclusive jurisdiction of the courts of India. Questions regarding these terms may be directed to our editorial desk via the Contact page.'
  }
];

const termsSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Terms & Conditions | NewzWale",
  "url": Astro.site ? new URL('/terms', Astro.site).toString() : '/terms',
  "isPartOf": {
    "@type": "WebSite",
    "name": "NewzWale",
    "url": "https://newzwale.com"
  }
};
---

<Layout title="Terms & Conditions | NewzWale">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(termsSchema)} />

  <Navbar />
  <MastheadInfoStrip />

  <main id="main" class="flex-1 py-12 bg-surface-soft">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="mb-10">
        <span class="font-mono-caption text-primary-strong text-xs font-semibold">LEGAL & TERMS</span>
        <h1 class="text-3xl sm:text-5xl font-bold text-ink tracking-tight mt-1">
          Terms & Conditions
        </h1>
        <p class="text-base text-body mt-3 leading-relaxed">
          Last updated: August 2026. These Terms & Conditions govern your use of the NewzWale platform and its associated services. Please read them carefully before using our service.
        </p>
      </div>

      <div class="space-y-6">
        {sections.map((section, index) => (
          <div class="p-6 bg-surface-elevated border border-hairline rounded-md">
            <div class="flex items-center gap-3 mb-2">
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-primary-strong text-on-primary text-[11px] font-mono font-bold flex items-center justify-center">
                {index + 1}
              </span>
              <h2 class="text-base font-bold text-ink">{section.heading}</h2>
            </div>
            <p class="pl-9 text-xs sm:text-sm text-body leading-relaxed">
              {section.body}
            </p>
          </div>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</Layout>