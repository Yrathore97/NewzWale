---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import MastheadInfoStrip from '../components/MastheadInfoStrip.astro';
import Footer from '../components/Footer.astro';

// P5 (NEWZWALE_ARCHITECTURE.md §4.1): "/methodology earns its own route
// rather than staying a page section: it is the document a sceptical reader
// is sent to, it needs to be linkable from every verdict badge, and burying
// the product's credibility argument inside a tool page undersells it."
// Also closes audit finding P-22 ("No /methodology route").
//
// Content below is the methodology section previously at
// verify.astro:47-71, moved verbatim — not rewritten, per the instruction not
// to invent new methodology claims.
export const prerender = true;
---

<Layout
  title="Fact-Checking Methodology | NewzWale"
  description="How NewzWale verifies claims: certified fact-check lookup, live web retrieval, and grounded AI assessment. States which verdicts are in active use."
>
  <Navbar />
  <MastheadInfoStrip />

  <main id="main" class="flex-1 py-8 bg-surface-soft">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 mb-4">
      <nav aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 text-xs text-mute font-mono-caption">
          <li><a href="/" class="hover:text-primary-strong">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/fact-check" class="hover:text-primary-strong">Fact Check</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-ink font-semibold">Methodology</li>
        </ol>
      </nav>
    </div>

    <section class="w-full py-4">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <span class="font-mono-caption text-primary-strong mb-2 block font-semibold">TRANSPARENCY & ACCURACY DISCLOSURE</span>
        <h1 class="text-3xl sm:text-5xl font-semibold tracking-[-1.5px] text-ink mb-6">
          NewzWale Verification Methodology
        </h1>

        <div class="space-y-6 text-sm text-body leading-relaxed">
          <div class="p-4 bg-surface-card border border-hairline rounded-md">
            <h2 class="font-semibold text-ink mb-1">1. Certified fact-check lookup</h2>
            <p>Every claim is first checked against Google Fact Check Tools, an index of reviews published by IFCN-affiliated fact-checkers. A match returns that publisher's rating directly, with a link to their review.</p>
          </div>

          <div class="p-4 bg-surface-card border border-hairline rounded-md">
            <h2 class="font-semibold text-ink mb-1">2. Live web retrieval</h2>
            <p>If no certified review exists, we run a live web search for the claim and fetch the text of the top results.</p>
          </div>

          <div class="p-4 bg-surface-card border border-hairline rounded-md">
            <h2 class="font-semibold text-ink mb-1">3. Grounded AI assessment</h2>
            <p>A model reads only the fetched source text — never outside knowledge — and returns one of six verdicts currently in active use: True, False, Partly true, Misleading, Not enough evidence, or Needs context. When the sources don't clearly address the claim, or none can be found, the verdict is always "not enough evidence" rather than a guess.</p>
          </div>
        </div>

        <p class="mt-8 text-sm">
          <a href="/fact-check" class="text-primary-strong font-semibold hover:underline">Check a claim →</a>
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
