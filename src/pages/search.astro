---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import MastheadInfoStrip from '../components/MastheadInfoStrip.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ArticleGrid from '../components/news/ArticleGrid.astro';
import FactCheckChip from '../components/news/FactCheckChip.astro';
import EmptyState from '../components/shared/EmptyState.astro';
import ErrorState from '../components/shared/ErrorState.astro';
import Footer from '../components/Footer.astro';
import type { ApiArticle } from '../lib/news/read';
import type { FactCheckRecord } from '../lib/db/repositories/fact-checks';
import type { ApiResponseBody } from '../lib/api/response';

// P5: "/search — Full-text over indexed articles + fact-checks", the
// documented ?q&type=news|factcheck|all&cursor contract from
// NEWZWALE_ARCHITECTURE.md §4.2, wired to /api/v1/search.
export const prerender = false;

const q = (Astro.url.searchParams.get('q') ?? '').trim();
const type = (['news', 'factcheck', 'all'].includes(Astro.url.searchParams.get('type') ?? '')
  ? Astro.url.searchParams.get('type')
  : 'news') as 'news' | 'factcheck' | 'all';

let news: ApiArticle[] = [];
let factChecks: FactCheckRecord[] = [];
let error: string | null = null;

if (q) {
  try {
    const res = await fetch(
      new URL(`/api/v1/search?q=${encodeURIComponent(q)}&type=${type}`, Astro.url),
    );
    const body = (await res.json()) as ApiResponseBody<
      ApiArticle[] | FactCheckRecord[] | { news: ApiArticle[]; factChecks: FactCheckRecord[] }
    >;

    if ('error' in body) {
      error = body.error.code === 'UPSTREAM_UNAVAILABLE' ? 'Search is not available right now.' : body.error.message;
    } else if (type === 'factcheck') {
      factChecks = body.data as FactCheckRecord[];
    } else if (type === 'all') {
      const combined = body.data as { news: ApiArticle[]; factChecks: FactCheckRecord[] };
      news = combined.news;
      factChecks = combined.factChecks;
    } else {
      news = body.data as ApiArticle[];
    }
  } catch {
    error = 'Search is not available right now.';
  }
}
---

<Layout
  title={q ? `Search: ${q} | NewzWale` : 'Search | NewzWale'}
  description="Search NewzWale's indexed articles and fact-checks."
>
  <Navbar />
  <MastheadInfoStrip />

  <main id="main" class="flex-1 py-8 bg-surface-soft">
    <div class="max-w-[1400px] mx-auto px-4 sm:px-6 mb-6">
      <nav aria-label="Breadcrumb" class="mb-4">
        <ol class="flex items-center gap-2 text-xs text-mute font-mono-caption">
          <li><a href="/" class="hover:text-primary-strong">Home</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-ink font-semibold">Search</li>
        </ol>
      </nav>
      <h1 class="text-3xl sm:text-4xl font-semibold text-ink tracking-tight mb-4">Search</h1>

      <form method="get" action="/search" class="flex flex-col sm:flex-row gap-2 max-w-2xl">
        <input
          type="search"
          name="q"
          value={q}
          placeholder="Search news and fact-checks…"
          aria-label="Search query"
          class="min-h-11 flex-1 rounded-sm border border-hairline bg-surface-elevated px-4 py-2.5 text-sm text-ink placeholder:text-mute"
        />
        <select name="type" aria-label="Search in" class="min-h-11 rounded-sm border border-hairline bg-surface-elevated px-3 py-2.5 text-sm text-ink">
          <option value="news" selected={type === 'news'}>News</option>
          <option value="factcheck" selected={type === 'factcheck'}>Fact checks</option>
          <option value="all" selected={type === 'all'}>Both</option>
        </select>
        <button type="submit" class="btn-pill-primary min-h-11 px-6 text-sm">
          Search
        </button>
      </form>
    </div>

    <div class="max-w-[1400px] mx-auto px-4 sm:px-6 space-y-8">
      {
        !q ? (
          <p class="text-sm text-body opacity-70">Enter a search term above.</p>
        ) : error ? (
          <ErrorState title="Couldn't search" description={error} retryLabel="Try again" retryHref={`/search?q=${encodeURIComponent(q)}&type=${type}`} />
        ) : (
          <>
            {(type === 'news' || type === 'all') && (
              <section>
                {type === 'all' && <h2 class="mb-3 text-lg font-semibold text-ink">News</h2>}
                {news.length === 0 ? (
                  <EmptyState
                    title={`No results for "${q}"`}
                    description="No indexed headlines match that search."
                    actionLabel="Check this as a claim →"
                    actionHref={`/fact-check?claim=${encodeURIComponent(q)}`}
                  />
                ) : (
                  <ArticleGrid>
                    {news.map((a) => (
                      <ArticleCard
                        article={{
                          id: a.id,
                          title: a.title,
                          url: a.url,
                          summary: a.summary ?? '',
                          imageUrl: a.imageUrl,
                          source: a.source,
                          category: a.category,
                          publishedAt: a.publishedAt ?? '',
                        }}
                      />
                    ))}
                  </ArticleGrid>
                )}
              </section>
            )}

            {(type === 'factcheck' || type === 'all') && (
              <section>
                {type === 'all' && <h2 class="mb-3 text-lg font-semibold text-ink">Fact checks</h2>}
                {factChecks.length === 0 ? (
                  <EmptyState
                    title={`No fact-checks for "${q}"`}
                    description="Nothing in the fact-check archive matches that search."
                    actionLabel="Check this as a claim →"
                    actionHref={`/fact-check?claim=${encodeURIComponent(q)}`}
                  />
                ) : (
                  <ul class="flex flex-col divide-y divide-hairline-soft">
                    {factChecks.map((fc) => (
                      <li class="py-3">
                        <a href={`/fact-check/${fc.id}`} class="flex min-h-11 flex-col gap-2">
                          <span class="text-[15px] font-medium leading-snug text-ink">{fc.claim}</span>
                          <FactCheckChip verdict={fc.verdict} />
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </section>
            )}
          </>
        )
      }
    </div>
  </main>

  <Footer />
</Layout>
