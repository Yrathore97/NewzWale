---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import MastheadInfoStrip from '../components/MastheadInfoStrip.astro';
import Footer from '../components/Footer.astro';

export const prerender = true;

// P10.1b: every factual claim below is traceable to shipped code.
//
// The previous copy described a product that does not exist — "account
// credentials (name and email when you sign up)", "authenticating your
// account", "Google for authentication (OAuth)", "saved bookmarks across
// devices", and deletion "from your account settings". NewzWale has no
// accounts, no sign-in, no OAuth, and no sync: saved articles, topics and
// fact-check history are localStorage only (src/lib/saved.ts,
// src/lib/history/factcheck-history.ts) and never leave the browser. The
// cross-device claim contradicted /saved's own on-page copy.
//
// Legal provisions (the data-selling commitment, retention periods, access
// control, regulatory compliance) are NOT rewritten here — code cannot verify
// them. Only factual product descriptions were corrected.
const sections = [
  {
    heading: 'What Stays On Your Device',
    body: 'Saved articles, your topic choices, your fact-check history, your language selection and your light/dark theme are stored in your browser\'s own local storage. They are never transmitted to us and never leave the device you set them on. There is no account to attach them to, so nothing syncs: saving an article on your phone will not make it appear on your laptop, and clearing your browser data clears them permanently.'
  },
  {
    heading: 'No Accounts, No Sign-In',
    body: 'NewzWale has no user accounts, no registration, no passwords and no third-party sign-in. We do not ask for, receive or store your name, email address or any other identity information, because there is nowhere in the product that would use it.'
  },
  {
    heading: 'What Reaches Our Servers',
    body: 'Reading headlines sends us the ordinary information any web request carries. Your IP address is used to apply rate limits, and Cloudflare supplies a city-level approximation of your location so the masthead can show local weather — that approximation is used on our servers only and is never passed to a third party. We do not ask your browser for precise GPS location; that permission is disabled site-wide.'
  },
  {
    heading: 'Fact Checks You Submit',
    body: 'A claim or URL you submit to the fact-checker is sent to our servers and, in the course of checking it, to Google\'s Fact Check Tools API, the Tavily search API, and Cloudflare Workers AI. The result is cached for up to 24 hours so an identical claim can be answered quickly. Where the public fact-check archive is enabled, a completed check — including the claim text — is stored as a public record with a shareable link. Please do not submit personal, confidential or identifying information to the fact-checker.'
  },
  {
    heading: 'Cookies & Analytics',
    body: 'NewzWale itself sets no cookies. We use Google Analytics to understand aggregate traffic, and its script sets its own cookies and receives standard analytics data under Google\'s privacy policy. Analytics currently loads on every page and we do not yet offer an in-product consent control; you can block it with your browser\'s or an extension\'s tracker blocking, which does not affect any other part of the site.'
  },
  {
    heading: 'Third-Party Services',
    body: 'We rely on Cloudflare for hosting, delivery and AI inference; NewsData.io, the Guardian and public RSS feeds for headlines; Google Fact Check Tools and Tavily for fact-check evidence; and Google Analytics for aggregate traffic measurement. Each processes data under its own privacy policy. Headlines link out to publishers\' own websites, which we do not control.'
  },
  {
    heading: 'Data Retention & Security',
    body: 'Device-local data stays until you clear it — we cannot see it, reach it or delete it for you. Fact-check results are cached for up to 24 hours; stored fact-check records are an append-only public archive rather than personal data tied to an individual. All traffic is served over HTTPS. Content-Security-Policy violation reports are written to server logs for diagnostics and are not stored in any database.'
  },
  {
    heading: 'Your Choices',
    body: 'Because there is no account, there are no account settings and no deletion request to file. You control everything device-local directly: clear your browser\'s site data to remove your saved articles, topics, fact-check history, language and theme. You can block analytics at the browser level. Publisher sites you open from a headline are governed by their own policies.'
  },
  {
    heading: 'Changes to This Policy',
    body: 'We may update this Privacy Policy periodically to reflect changes in our practices or legal obligations. Material changes will be reflected on this page with a revised "last updated" date. Continued use of NewzWale after updates constitutes acceptance of the revised policy.'
  },
  {
    heading: 'Contact Us',
    body: 'For privacy-related inquiries, corrections, or data requests, please reach out through our Contact page. Our editorial and data-protection team will respond within a reasonable timeframe.'
  }
];

const privacySchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Privacy Policy | NewzWale",
  "url": Astro.site ? new URL('/privacy', Astro.site).toString() : '/privacy',
  "isPartOf": {
    "@type": "WebSite",
    "name": "NewzWale",
    "url": "https://newzwale.com"
  }
};
---

<Layout title="Privacy Policy | NewzWale">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(privacySchema)} />

  <Navbar />
  <MastheadInfoStrip />

  <main id="main" class="flex-1 py-12 bg-surface-soft">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="mb-10">
        <span class="font-mono-caption text-primary-strong text-xs font-semibold">LEGAL & PRIVACY</span>
        <h1 class="text-3xl sm:text-5xl font-bold text-ink tracking-tight mt-1">
          Privacy Policy
        </h1>
        <p class="text-base text-body mt-3 leading-relaxed">
          Last updated: August 2026. NewzWale ("we", "our", "us") is committed to protecting your privacy and handling your personal data with transparency. This policy explains what we collect, how we use it, and the choices you have.
        </p>
      </div>

      <div class="space-y-6">
        {sections.map((section, index) => (
          <div class="p-6 bg-surface-elevated border border-hairline rounded-md">
            <div class="flex items-center gap-3 mb-2">
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-primary-strong text-on-primary text-[11px] font-mono font-bold flex items-center justify-center">
                {index + 1}
              </span>
              <h2 class="text-base font-bold text-ink">{section.heading}</h2>
            </div>
            <p class="pl-9 text-xs sm:text-sm text-body leading-relaxed">
              {section.body}
            </p>
          </div>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</Layout>