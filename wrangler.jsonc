{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-08-04",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "newzwale",
	// Points at our own entry module, NOT the adapter directly: a cron trigger
	// calls `scheduled()` on the default export, and the adapter's entrypoint
	// exports only `fetch`. src/worker.ts re-exports the adapter's `fetch`
	// unchanged and adds `scheduled` beside it, so the request path is
	// byte-for-byte the same behaviour.
	"main": "./src/worker.ts",
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS"
	},
	"kv_namespaces": [
		{ "binding": "NEWZ_CACHE", "id": "e05934d898ea4c90b96f0df3bade9191" },
		// The Astro Cloudflare adapter auto-enables sessions and injects a
		// SESSION binding with no id. Declared here so deploys don't fail.
		{ "binding": "SESSION", "id": "1850d81959b6492fa926dea8cbe993f2" }
	],
	"ai": { "binding": "AI" },

	// D1 — provisioned via `wrangler d1 create newzwale`. Migrations applied:
	// 0001_init.sql, 0002_nullable_published_at.sql. See src/lib/db/migrations/.
	"d1_databases": [
		{
			"binding": "NEWZ_DB",
			"database_name": "newzwale",
			"database_id": "6093befe-8889-4e28-bb1d-471d07d8c18d"
		}
	],

	// The IMAGES binding is deliberately NOT declared here.
	//
	// @astrojs/cloudflare resolves `imageService` to 'cloudflare-binding' by
	// default and auto-injects `images: { binding: "IMAGES" }` when this file
	// declares none (verified in dist/wrangler.js). Unlike a KV namespace, an
	// Images binding needs no id, so the adapter can supply it in full and
	// there is nothing to declare. Cloudflare Images is therefore ALREADY
	// ACTIVE in production. See docs/NEWZWALE_AUDIT.md, correction to P-19.

	"observability": {
		"enabled": true
	},

	// Cron — scheduled ingestion, off the read path.
	//
	// Without this, D1 stayed empty forever: `ingest()` had no caller, so
	// /trending and /search rendered a correct-but-permanent empty state.
	//
	// SCHEDULE IS QUOTA-SIZED, not freshness-sized. One tick spends one
	// NewsData request per category (see src/lib/news/schedule.ts):
	//
	//     8 categories x 12 ticks/day = 96 NewsData requests/day
	//
	// against a documented 200/day free tier — roughly half, deliberately,
	// because the on-demand read path (/api/news, which still serves the
	// homepage) spends from the SAME quota on a cache miss. Raising the
	// frequency or widening to more languages without re-measuring that
	// shared spend is how the feed goes dark mid-afternoon.
	"triggers": {
		"crons": ["0 */2 * * *"]
	}

	// ─────────────────────────────────────────────────────────────────────────
	// TARGET ARCHITECTURE — PREPARED, NOT YET ACTIVE
	//
	// The blocks below are the approved Phase 2+ bindings not yet in the active
	// config above. They are commented out ON PURPOSE: each needs a real
	// resource id that must be created against the Cloudflare account at
	// deploy time. Inventing placeholder ids would produce a config that looks
	// valid and fails at deploy, which is worse than an obviously absent one.
	//
	// Uncomment each block only in the phase that starts using it, after
	// running the matching provisioning command and pasting the REAL id.
	//
	// (D1 and Cron were here — both now active above, following this pattern.)
	//
	// ── Durable Object (Phase 1 — atomic rate limiting) ──────────────────────
	// IMPLEMENTED in src/lib/durable/rate-limiter.ts and exported from
	// src/worker.ts. Replaces the non-atomic KV counter: KV has no atomic
	// increment, so the old read-then-write limiter let N concurrent requests
	// all pass. See NEWZWALE_SECURITY_AUDIT.md S-01.
	//
	// The application already handles the binding being ABSENT — see
	// checkRateLimitSafe() in src/lib/ratelimit.ts, which fails OPEN and logs.
	// That is why this can stay commented out without breaking anything.
	//
	// TO ENABLE (no account id needed — Durable Objects are provisioned by the
	// deploy itself, unlike D1). `main` already points at ./src/worker.ts, so
	// only these two blocks remain:
	//
	// "durable_objects": {
	//   "bindings": [
	//     { "name": "RATE_LIMITER", "class_name": "RateLimiter" }
	//   ]
	// },
	// "migrations": [
	//   { "tag": "v1", "new_sqlite_classes": ["RateLimiter"] }
	// ],
	// ─────────────────────────────────────────────────────────────────────────
}
